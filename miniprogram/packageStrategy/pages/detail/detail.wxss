.detail-page {
  background: #0f1923; /* 瓦罗兰特极暗蓝 */
  min-height: 100vh;
  padding: 0 40rpx;
}

/* 顶部导航 */
.step-nav {
  display: flex;
  justify-content: space-between;
  padding: 60rpx 0 40rpx;
}

.step-item {
  display: flex;
  align-items: center;
  opacity: 0.3;
  transition: all 0.3s;
}

.step-item.active {
  opacity: 1;
}

.step-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4655;
  margin-right: 15rpx;
  font-family: "DIN Alternate", sans-serif;
}

.step-t {
  display: block;
  font-size: 24rpx;
  color: #ece8e1;
}

.step-s {
  font-size: 16rpx;
  color: #8b9196;
}

/* 核心查看器 */
.viewer-container {
  width: 100%;
  height: 500rpx;
  background: #1f2326;
  position: relative;
  border: 1rpx solid #383e44;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.main-img {
  width: 100%;
  height: 100%;
}

/* 装饰角 */
.frame-corner {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #ff4655;
}
.frame-corner.lt {
  top: -2rpx;
  left: -2rpx;
  border-right: none;
  border-bottom: none;
}
.frame-corner.rb {
  bottom: -2rpx;
  right: -2rpx;
  border-left: none;
  border-top: none;
}

/* 文字说明 */
.desc-area {
  margin-top: 50rpx;
  height: calc(100vh - 800rpx);
}

.title-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.red-bar {
  width: 10rpx;
  height: 40rpx;
  background: #ff4655;
  margin-right: 20rpx;
}

.detail-title {
  color: #ece8e1;
  font-size: 36rpx;
  font-weight: bold;
}

.meta-tags {
  margin-bottom: 40rpx;
}

.tag {
  font-size: 20rpx;
  color: #ff4655;
  border: 1rpx solid #ff4655;
  padding: 4rpx 12rpx;
  margin-right: 20rpx;
  text-transform: uppercase;
}

.text-content .label {
  display: block;
  font-size: 20rpx;
  color: #8b9196;
  margin-bottom: 15rpx;
}

.description {
  color: #ece8e1;
  font-size: 28rpx;
  line-height: 1.6;
}
