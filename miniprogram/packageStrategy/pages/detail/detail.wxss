/* --- 基础设置 & 全局背景 --- */
page {
  background: #0f1923; /* 瓦罗兰特主底色 */
  color: #ece8e1;
  /* font-family:
    "PingFang SC",
    -apple-system,
    sans-serif; */
}

.detail-container {
  padding-bottom: 180rpx;
}

/* 顶部预览模式提示 */
.preview-header {
  background: #ff4655;
  color: #fff;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 0;
  letter-spacing: 4rpx;
  font-weight: 900;
  position: sticky;
  top: 0;
  z-index: 200;
}

/* --- Header 区域：强化攻防区分 --- */
.top-header {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 30rpx 40rpx;
  position: relative;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(236, 232, 225, 0.05);
}

/* 攻防氛围渲染：整个头部带上色调倾向 */
.top-header.atk {
  background: linear-gradient(
    180deg,
    rgba(255, 70, 85, 0.15) 0%,
    transparent 100%
  );
}
.top-header.def {
  background: linear-gradient(
    180deg,
    rgba(0, 238, 255, 0.1) 0%,
    transparent 100%
  );
}

.agent-title-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-main-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 🚩 英雄小图标样式 */
.header-agent-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  flex-shrink: 0;
}

.title-area {
  /* display: inline-flex;  */
  align-items: center;
  /* background: rgba(236, 232, 225, 0.05);  */
  padding: 16rpx;
  padding-left: 0;
  height: 44rpx; /* 固定高度让它们看起来像一个模组 */
  padding-bottom: 0;
}

/* 1. 地图名称：增加前缀感 */
.map-name {
  font-size: 26rpx;
  font-weight: 900;
  color: #ece8e1;
  padding: 0 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  position: relative;
}

/* 在地图名和标签之间加一个几何斜线分割，增强协同性 */
.map-name::after {
  content: "";
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: rgba(236, 232, 225, 0.2);
  transform: rotate(15deg);
}

/* 阵营状态：使用半透明背景或发光文字区分 */
.side-badge.atk {
  color: #ff4655;
  /* 增加一个非常淡的红色背景，与地图名的灰色区分 */
  background: rgba(255, 70, 85, 0.1);
}

.side-badge.def {
  color: #00eeff;
  background: rgba(0, 238, 255, 0.1);
}

/* 攻防实色标签：一眼识别 */
.side-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 900;
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  letter-spacing: 2rpx;
  vertical-align: middle;
  text-transform: uppercase;
  /* width: 80rpx; */
  align-items: center;
}
.side-badge.atk {
  background: #ff4655;
  color: #fff;
}
.side-badge.def {
  background: #00eeff;
  color: #0f1923;
}

.main-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #ece8e1;
  line-height: 1.1;
  text-transform: uppercase;
}

.map-meta {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(236, 232, 225, 0.4);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.map-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #ece8e1;
  letter-spacing: 2rpx;
  display: inline-block;
  margin-right: 20rpx;
  vertical-align: middle;
}

.date-label {
  font-size: 18rpx;
  color: rgba(236, 232, 225, 0.2); /* 极淡，不抢戏 */
}

/* --- 贡献者区域：档案卡片化 --- */
/* --- 贡献者区域：档案标签化 --- */
.contributor-box {
  margin-top: 40rpx;
  display: flex;
  align-items: center; /* 🚩 核心：确保头像和文字容器垂直居中对齐 */
  background: rgba(236, 232, 225, 0.03);
  border: 1rpx solid rgba(236, 232, 225, 0.08);
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  width: fit-content; /* 宽度随内容自适应 */
}

.user-avatar {
  width: 72rpx; /* 稍微加大一点点，增强视觉平衡 */
  height: 72rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(236, 232, 225, 0.2);
  margin-right: 24rpx; /* 增加与文字的间距 */
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center; /* 🚩 让三行文字在 72rpx 的高度内均匀分布 */
  gap: 2rpx; /* 控制行与行之间的微小间距 */
}

.user-label {
  font-size: 16rpx;
  color: rgba(236, 232, 225, 0.3);
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.user-name {
  font-size: 26rpx;
  color: #ece8e1; /* 使用你要求的显眼米白 */
  font-weight: 900;
  line-height: 1.2;
}

.date-label {
  font-size: 18rpx;
  color: rgba(236, 232, 225, 0.2);
  font-family:
    "IBM Plex Mono", Consolas, monospace; /* 使用等宽字体，更有档案感 */
  margin-top: 4rpx;
}

/* --- 视频按钮逻辑 --- */
.video-trigger-container {
  padding: 30rpx;
  /* padding-top: 20rpx; */
  padding-bottom: 10rpx;
}
.video-btn {
  position: relative;
  height: 80rpx;
  width: 40%;
  /* 使用瓦服经典的黄色系，不属于任何阵营，但极其显眼 */
  background: #ece8e1;
  display: flex;
  align-items: center;
  overflow: hidden;
  /* 倾斜切角效果 */
  /* clip-path: polygon(0 0, 95% 0, 100% 30%, 100% 100%, 5% 100%, 0 70%); */
  transition: all 0.2s ease;
}
.video-btn-content {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}
.v-icon {
  font-size: 28rpx;
  color: #0f1923; /* 深色文字与亮色背景形成极强对比 */
  margin-right: 20rpx;
}
.v-cn {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f1923;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.v-en {
  font-size: 16rpx;
  color: rgba(255, 70, 85, 0.5);
  font-family: monospace;
}

/* --- 模块标题：视觉瘦身（去掉竖线） --- */
.module-section {
  margin: 20rpx 20rpx 0; /* 统一左右 40rpx 边距 */
  /* margin-top: 20rpx; */
}
.module-head {
  padding: 0 30rpx;
  margin-bottom: 14rpx;
  margin-top: 10rpx;
}
/* 改用文字底部的装饰短线，不再使用乱糟糟的侧边竖线 */
.module-head text {
  font-size: 26rpx;
  font-weight: bold;
  color: rgba(236, 232, 225, 0.5);
  letter-spacing: 4rpx;
  text-transform: uppercase;
  position: relative;
  padding-bottom: 10rpx;
  color: rgba(236, 232, 225, 0.9); /* 较亮的标签色 */
  border-bottom: 4rpx solid rgba(236, 232, 225, 0.5);
}

/* --- 地图标点核心 (保持原逻辑样式) --- */
.map-mark-container {
  /* width: 100%; */
  height: 520rpx;
  background: #05090d;
  border-top: 1rpx solid rgba(236, 232, 225, 0.1);
  border-bottom: 1rpx solid rgba(236, 232, 225, 0.1);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}
.map-area,
.map-touch-view {
  width: 100%;
  height: 100%;
}
.map-base-img {
  width: 100%;
  height: 100%;
  opacity: 0.6;
}

.map-pointer {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  transform: translate(-50%, -50%);
  z-index: 100;
}
.pointer-core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #ff4655;
  box-sizing: border-box;
}
.map-pointer.def .pointer-core {
  border-color: #00eeff;
}
.pointer-ripple {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: #ff4655;
  opacity: 0.3;
  animation: ripple 1.5s infinite;
}
.map-pointer.def .pointer-ripple {
  background: #00eeff;
}

@keyframes ripple {
  0% {
    transform: scale(1);
    opacity: 0.5;
  }
  100% {
    transform: scale(3);
    opacity: 0;
  }
}

/* --- 图片查看器 swiper --- */
.viewer-container {
  position: relative;
  /* margin: 0 30rpx; */
  background: #000;
}
.image-swiper {
  height: 450rpx;
}
.main-img {
  width: 100%;
  height: 100%;
}

.swiper-counter {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(15, 25, 35, 0.8);
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #ff4655;
  font-family: monospace;
}

/* 描述文字 & 总结卡片 */
.memo-box {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  margin: 0 0rpx;
}
.memo-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(236, 232, 225, 0.8);
}
.desc-card {
  margin: 0 20rpx;
  padding: 20rpx;
  /* background: rgba(255, 70, 85, 0.05); */
  /* border-left: 6rpx solid #ff4655; */
  font-size: 28rpx;
  line-height: 1.8;
}

.memo-content,
.desc-card {
  /* 之前是 28rpx，现在调小到 24rpx，确保小于 Label 的视觉重量 */
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(236, 232, 225, 0.5); /* 降低亮度，营造“备注”感 */
  text-align: justify;
  word-break: break-all;
  color: #8b9196;
}

/* --- 底部悬浮交互栏 (毛玻璃) --- */
.tactical-horizontal-widget {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  height: 80rpx;
  background: rgba(31, 35, 38, 0.9);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
  padding: 0 40rpx;
  z-index: 100;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.5);
  transition: all 0.3s;
}
.widget-hidden {
  transform: translate(-50%, 200%);
}
.h-widget-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
}
.h-icon {
  font-size: 32rpx;
  margin: 0 10rpx;
  color: #8b9196;
}
.h-count {
  font-size: 28rpx;
  font-family: monospace;
  font-weight: bold;
}
.h-widget-item.up.active .h-icon,
.h-widget-item.up.active .h-count {
  color: #ff4655;
}
.h-widget-item.down.active .h-icon,
.h-widget-item.down.active .h-count {
  color: #00eeff;
}
.h-divider {
  width: 1rpx;
  height: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 30rpx;
}

.footer-safe-area {
  height: 80rpx;
}
