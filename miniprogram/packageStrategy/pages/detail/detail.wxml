<view class="detail-container">
    <view class="preview-header" wx:if="{{isPreview}}">TACTICAL PREVIEW / 战术预演模式</view>
    <view class="top-header">
        <view class="title-row">
            <text class="main-title">{{detail.title}}</text>
            <view class="side-tag {{detail.side}}">
                {{detail.side === 'atk' ? '攻击方 / ATK' : '防守方 / DEF'}}
            </view>
        </view>
        <view class="map-info-row">
            <text class="map-name">{{detail.mapName}}</text>
            <text class="date-label">{{detail.createTimeDisplay || 'ARCHIVE RECORD'}}</text>
        </view>
    </view>
    <view class="module-section">
        <view class="module-head">
            <view class="head-line"></view>
            <text>DEPLOYMENT / 部署位置</text>
        </view>
        <view class="map-mark-container detail-mode">
            <movable-area class="map-area">
                <movable-view class="map-touch-view" direction="all" scale="{{true}}" scale-min="1" scale-max="3">
                    <image class="map-base-img" src="{{mapBaseIcon}}" mode="aspectFit" />
                    <view class="map-pointer {{item.side}}" wx:for="{{detail.markPoints}}" wx:key="index" style="left: {{item.x * 100}}%; top: {{item.y * 100}}%;">
                        <view class="pointer-core"></view>
                        <view class="pointer-ripple"></view>
                    </view>
                </movable-view>
            </movable-area>
        </view>
    </view>
    <block wx:for="{{[{key:'standImg', label:'POSITION / 站位详情', idx:'standIndex'}, {key:'aimImg', label:'AIMING / 瞄准点位', idx:'aimIndex'}, {key:'enemyImg', label:'ENEMY VIEW / 敌方视角', idx:'enemyIndex'}, {key:'resultImg', label:'EFFECT / 最终效果', idx:'resultIndex'}]}}" wx:key="key" wx:for-item="mod">
        <view class="module-section" wx:if="{{detail[mod.key] && detail[mod.key].length > 0}}">
            <view class="module-head">
                <view class="head-line"></view>
                <text>{{mod.label}}</text>
            </view>
            <view class="viewer-container">
                <swiper class="image-swiper" bindchange="onSwiperChange" data-field="{{mod.idx}}">
                    <swiper-item wx:for="{{detail[mod.key]}}" wx:for-item="imgItem" wx:key="index">
                        <image src="{{imgItem.url}}" mode="aspectFit" class="main-img" bindtap="previewImage" data-src="{{imgItem.url}}" data-list="{{detail[mod.key]}}" />
                    </swiper-item>
                </swiper>
                <view class="frame-corner lt"></view>
                <view class="frame-corner rb"></view>
                <view class="swiper-counter">
                    <text wx:if="{{mod.key === 'standImg'}}">{{standIndex + 1}}</text>
                    <text wx:if="{{mod.key === 'aimImg'}}">{{aimIndex + 1}}</text>
                    <text wx:if="{{mod.key === 'enemyImg'}}">{{enemyIndex + 1}}</text>
                    <text wx:if="{{mod.key === 'resultImg'}}">{{resultIndex + 1}}</text>
                    / {{detail[mod.key].length}}
                </view>
            </view>
            <view class="memo-box">
                <view class="memo-deco"></view>
                <view class="memo-content">
                    <text class="memo-text" wx:if="{{mod.key === 'standImg'}}">
                        {{detail.standImg[standIndex].memo || '暂无详细描述'}}
                    </text>
                    <text class="memo-text" wx:if="{{mod.key === 'aimImg'}}">
                        {{detail.aimImg[aimIndex].memo || '暂无详细描述'}}
                    </text>
                    <text class="memo-text" wx:if="{{mod.key === 'enemyImg'}}">
                        {{detail.enemyImg[enemyIndex].memo || '暂无详细描述'}}
                    </text>
                    <text class="memo-text" wx:if="{{mod.key === 'resultImg'}}">
                        {{detail.resultImg[resultIndex].memo || '暂无详细描述'}}
                    </text>
                </view>
            </view>
        </view>
    </block>
    <view class="module-section" wx:if="{{detail.desc}}">
        <view class="module-head">
            <view class="head-line"></view>
            <text>DESCRIPTION / 战术总结</text>
        </view>
        <view class="desc-card">{{detail.desc}}</view>
    </view>
    <view class="footer-safe-area"></view>
</view>