<view class="detail-container">
    <view class="preview-header" wx:if="{{isPreview}}">预览</view>
    <view class="top-header {{detail.side}}">
        <view class="header-main-info">
            <view class="title-area">
                <view class="map-name">{{detail.mapName}}</view>
                <view class="side-badge {{detail.side}}">
                    {{detail.side === 'atk' ? '攻击方' : '防守方'}}
                </view>
            </view>
            <view class="agent-title-row">
                <image wx:if="{{detail.agentId}}" class="header-agent-icon" src="https://636c-cloud1-5gqun0xd80e8dd85-1396911701.tcb.qcloud.la/icons/{{detail.agentId}}.png" mode="aspectFit" />
                <text class="main-title">{{detail.title}}</text>
            </view>
        </view>
        <view class="contributor-box">
            <image class="user-avatar" src="{{detail.creator.avatar || '../../../assets/default_icon.png'}}" mode="aspectFill" />
            <view class="user-info">
                <text class="user-label">贡献者：</text>
                <text class="user-name">{{detail.creator.nickname || '未知特工'}}</text>
                <text class="date-label">{{detail.createTimeDisplay || '2024/05/20'}}</text>
            </view>
        </view>
    </view>
    <view class="video-trigger-container" wx:if="{{detail.videoFeedId}}">
        <view class="video-btn" bindtap="playTacticalVideo">
            <view class="video-btn-glow"></view>
            <view class="video-btn-content">
                <text class="v-icon">▶</text>
                <view class="v-text">
                    <text class="v-cn">视频演示</text>
                    <!-- <text class="v-en">// LIVE_RECORDING</text> -->
                </view>
            </view>
            <view class="v-corner"></view>
        </view>
    </view>
    <!-- <view class="embedded-video" wx:if="{{detail.videoFeedId}}">
        <channel-video finder-user-name="sphJEriMoMTht1o" feed-id="{{detail.videoFeedId}}" class="v-player"></channel-video>
    </view> -->
    <view class="module-section">
        <view class="module-head">
            <view class="head-line"></view>
            <text>部署位置</text>
        </view>
        <view class="map-mark-container detail-mode">
            <movable-area class="map-area">
                <movable-view class="map-touch-view" direction="all" scale="{{true}}" scale-min="1" scale-max="3">
                    <image class="map-base-img" src="{{mapBaseIcon}}" mode="aspectFit" />
                    <view class="map-pointer {{item.side}}" wx:for="{{detail.markPoints}}" wx:key="index" style="left: {{item.x * 100}}%; top: {{item.y * 100}}%;">
                        <view class="pointer-core"></view>
                        <view class="pointer-ripple"></view>
                    </view>
                </movable-view>
            </movable-area>
        </view>
    </view>
    <block wx:for="{{[{key:'standImg', label:'站位详情', idx:'standIndex'}, {key:'aimImg', label:'瞄准点位', idx:'aimIndex'}, {key:'enemyImg', label:'敌方视角', idx:'enemyIndex'}, {key:'resultImg', label:'EFFECT / 最终效果', idx:'resultIndex'}]}}" wx:key="key" wx:for-item="mod">
        <view class="module-section" wx:if="{{detail[mod.key] && detail[mod.key].length > 0}}">
            <view class="module-head">
                <view class="head-line"></view>
                <text>{{mod.label}}</text>
            </view>
            <view class="viewer-container">
                <swiper class="image-swiper" bindchange="onSwiperChange" data-field="{{mod.idx}}">
                    <swiper-item wx:for="{{detail[mod.key]}}" wx:for-item="imgItem" wx:key="index">
                        <image src="{{imgItem.url}}" mode="aspectFit" class="main-img" bindtap="previewImage" data-src="{{imgItem.url}}" data-list="{{detail[mod.key]}}" />
                    </swiper-item>
                </swiper>
                <!-- <view class="frame-corner lt"></view> -->
                <!-- <view class="frame-corner rb"></view> -->
                <view class="swiper-counter">
                    <text wx:if="{{mod.key === 'standImg'}}">{{standIndex + 1}}</text>
                    <text wx:if="{{mod.key === 'aimImg'}}">{{aimIndex + 1}}</text>
                    <text wx:if="{{mod.key === 'enemyImg'}}">{{enemyIndex + 1}}</text>
                    <text wx:if="{{mod.key === 'resultImg'}}">{{resultIndex + 1}}</text>
                    / {{detail[mod.key].length}}
                </view>
            </view>
            <view class="memo-box">
                <view class="memo-content" wx:if="{{mod.key === 'standImg'}}">
                    {{detail.standImg[standIndex].memo || '暂无详细描述'}}
                </view>
                <view class="memo-content" wx:if="{{mod.key === 'aimImg'}}">
                    {{detail.aimImg[aimIndex].memo || '暂无详细描述'}}
                </view>
                <view class="memo-content" wx:if="{{mod.key === 'enemyImg'}}">
                    {{detail.enemyImg[enemyIndex].memo || '暂无详细描述'}}
                </view>
                <view class="memo-content" wx:if="{{mod.key === 'resultImg'}}">
                    {{detail.resultImg[resultIndex].memo || '暂无详细描述'}}
                </view>
            </view>
        </view>
    </block>
    <view class="module-section" wx:if="{{detail.desc}}">
        <view class="module-head">
            <view class="head-line"></view>
            <text>战术总结</text>
        </view>
        <view class="desc-card">{{detail.desc}}</view>
    </view>
    <view class="tactical-horizontal-widget {{isHideBar ? 'widget-hidden' : ''}}">
        <view class="h-widget-bg"></view>
        <view class="h-widget-item up {{userAction === 'up' ? 'active' : ''}}" bindtap="handleAssess" data-type="up">
            <view class="h-icon">▲</view>
            <text class="h-count">{{detail.stats.up || 0}}</text>
        </view>
        <view class="h-divider"></view>
        <view class="h-widget-item down {{userAction === 'down' ? 'active' : ''}}" bindtap="handleAssess" data-type="down">
            <text class="h-count">{{detail.stats.down || 0}}</text>
            <view class="h-icon">▼</view>
        </view>
    </view>
    <view class="footer-safe-area"></view>
</view>