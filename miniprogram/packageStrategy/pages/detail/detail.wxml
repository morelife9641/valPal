<view class="detail-page">
    <view class="step-nav">
        <view class="step-item {{current === index ? 'active' : ''}}" wx:for="{{steps}}" wx:key="index" bindtap="switchStep" data-index="{{index}}">
            <text class="step-num">0{{index + 1}}</text>
            <view class="step-info">
                <text class="step-t">{{item.title}}</text>
                <text class="step-s">{{item.sub}}</text>
            </view>
        </view>
    </view>
    <view class="viewer-container">
        <swiper class="image-swiper" current="{{current}}" bindchange="onSwiperChange" duration="300">
            <swiper-item wx:for="{{detail.images}}" wx:key="*this">
                <image src="{{item}}" mode="aspectFit" bindtap="previewImage" class="main-img" />
            </swiper-item>
        </swiper>
        <view class="frame-corner lt"></view>
        <view class="frame-corner rb"></view>
    </view>
    <scroll-view scroll-y class="desc-area">
        <view class="title-section">
            <view class="red-bar"></view>
            <text class="detail-title">{{detail.title}}</text>
        </view>
        <view class="meta-tags">
            <text class="tag">MAP: {{detail.mapName}}</text>
            <text class="tag">AGENT: {{detail.heroName}}</text>
        </view>
        <view class="text-content">
            <text class="label">战术详解 / DESCRIPTION</text>
            <text class="description">{{detail.desc || '暂无详细描述资料。'}}</text>
        </view>
    </scroll-view>
</view>