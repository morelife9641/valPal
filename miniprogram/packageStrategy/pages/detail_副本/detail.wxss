page {
  background: #0f1923;
  height: 100vh;
  overflow: hidden;
}

.editor-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.editor-container.ready {
  opacity: 1;
}

/* --- 顶部 Header --- */
.tactical-header {
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(to bottom, rgba(22, 29, 36, 0.9), transparent);
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10;
  box-sizing: border-box;
}

.agent-badge {
  display: flex;
  align-items: center;
}
.agent-badge image {
  width: 80rpx;
  height: 80rpx;
  background: #ff4655;
  clip-path: polygon(0 0, 100% 0, 100% 80%, 80% 100%, 0 100%);
  margin-right: 20rpx;
}

.agent-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #ece8e1;
  display: block;
}
.op-status {
  font-size: 16rpx;
  color: #ff4655;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.map-badge {
  font-size: 20rpx;
  color: #8b978f;
  border: 1rpx solid #333;
  padding: 4rpx 16rpx;
  transform: skewX(-15deg);
}

/* --- Canvas 容器 --- */
.canvas-wrap {
  flex: 1;
  position: relative;
  background: #000;
}

#mapCanvas {
  width: 100%;
  height: 100%;
}

.canvas-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  pointer-events: none;
  letter-spacing: 4rpx;
}

/* --- 底部操作面板 --- */
.footer-panel {
  background: #161d24;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 2rpx solid #ff4655;
  z-index: 20;
}

.tab-header {
  display: flex;
  border-bottom: 1rpx solid #232931;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 22rpx;
  color: #8b978f;
  transition: all 0.3s;
}

.tab-item.active {
  color: #fff;
  background: rgba(255, 70, 85, 0.1);
  box-shadow: inset 0 -4rpx 0 #ff4655;
}

.icon-picker {
  white-space: nowrap;
  padding: 30rpx 0;
  height: 160rpx;
}

.icon-box {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin: 0 20rpx;
  opacity: 0.5;
  transition: opacity 0.3s;
}

.icon-box.active {
  opacity: 1;
}

.icon-box image {
  width: 80rpx;
  height: 80rpx;
  background: #0f1923;
  margin-bottom: 10rpx;
}

.icon-label {
  font-size: 18rpx;
  color: #8b978f;
}

/* 全局按钮 */
.global-actions {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.action-btn.undo {
  background: #232931;
  color: #ece8e1;
}

.action-btn.save {
  background: #ff4655;
  color: #fff;
  clip-path: polygon(0 0, 95% 0, 100% 20%, 100% 100%, 5% 100%, 0 80%);
}
