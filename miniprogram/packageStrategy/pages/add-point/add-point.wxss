/* ==========================================
   战术上传页面 - 核心布局
   ========================================== */
.add-container {
  background-color: #0f1923;
  height: 100vh;
  display: flex;
  flex-direction: column;
  color: #ece8e1;
}

/* 顶部标题区 */
.page-header {
  padding: 20rpx 40rpx 20rpx;
  background: linear-gradient(to bottom, rgba(255, 70, 85, 0.1), transparent);
}

.title {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #ff4655;
}

/* 滚动区域：关键是 flex: 1 和 height: 1px */
.form-scroll {
  flex: 1;
  height: 1px;
}

.form-content {
  padding: 0 40rpx 60rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 22rpx;
  font-weight: 700;
  color: #ece8e1;
  margin-bottom: 15rpx;
  display: block;
  border-left: 6rpx solid #ff4655;
  padding-left: 15rpx;
  line-height: 1;
}

/* ==========================================
   输入项与对齐补丁
   ========================================== */

/* 标题输入框强化：防止遮挡 & 视觉对齐 */
.custom-input,
.custom-select,
.align-height {
  height: 90rpx; /* 统一高度 */
  background: rgba(236, 232, 225, 0.05);
  border: 1rpx solid rgba(236, 232, 225, 0.2);
  color: #ece8e1;
  font-size: 28rpx;
  box-sizing: border-box;
}

.title-input {
  width: 100%;
  padding: 0 24rpx;
  border-bottom: 4rpx solid #ff4655; /* 强调输入项 */
}

/* 栅格化：一行两列 */
.form-row-split {
  display: flex;
  gap: 20rpx;
}

.flex-1 {
  flex: 1;
}

/* 阵营选择 */
.side-selector {
  display: flex;
  gap: 10rpx;
  background: transparent;
  border: none;
}

.side-btn {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1f2326;
  border: 1rpx solid rgba(236, 232, 225, 0.2);
  transition: all 0.2s;
}

.side-text {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(236, 232, 225, 0.3);
}

.side-btn.active.atk {
  border-color: #ff4655;
  background: rgba(255, 70, 85, 0.1);
}
.side-btn.active.atk .side-text {
  color: #ff4655;
}

.side-btn.active.def {
  border-color: #00eeff;
  background: rgba(0, 238, 255, 0.1);
}
.side-btn.active.def .side-text {
  color: #00eeff;
}

/* 基础样式保持你之前的 */
.side-btn.point {
  /* 基础边框和背景保持一致 */
}

/* --- A区激活：琥珀金 --- */
.side-btn.active.A {
  border-color: #ffb800;
  background: rgba(255, 184, 0, 0.1);
}
.side-btn.active.A .side-text {
  color: #ffb800;
  text-shadow: 0 0 8rpx rgba(255, 184, 0, 0.3);
}

/* --- B区激活：荧光绿 --- */
.side-btn.active.B {
  border-color: #3ad4af;
  background: rgba(58, 212, 175, 0.1);
}
.side-btn.active.B .side-text {
  color: #3ad4af;
  text-shadow: 0 0 8rpx rgba(58, 212, 175, 0.3);
}

/* --- 其他激活：战术灰白 --- */
.side-btn.active.other {
  border-color: #ece8e1;
  background: rgba(236, 232, 225, 0.15);
}
.side-btn.active.other .side-text {
  color: #ece8e1;
  text-shadow: 0 0 8rpx rgba(236, 232, 225, 0.3);
}

/* 地图选择 */
.picker-inner-text {
  width: 100%;
  line-height: 88rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

/* ==========================================
   地图标点系统
   ========================================== */
.map-mark-container {
  width: 100%;
  height: 500rpx;
  background-color: #05090d;
  border: 1rpx solid rgba(236, 232, 225, 0.15);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden; /* 强制截断，不让放大后的地图流出容器 */
}

.map-mark-container.editing-active {
  border-color: #ff4655;
}

.map-controls {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  z-index: 100;
  display: flex;
  gap: 12rpx;
}

.control-btn {
  background: rgba(15, 25, 35, 0.9);
  border: 1rpx solid rgba(236, 232, 225, 0.3);
  padding: 8rpx 18rpx;
  font-size: 18rpx;
  color: #ece8e1;
  font-weight: 900;
  clip-path: polygon(10% 0, 100% 0, 100% 70%, 90% 100%, 0 100%, 0 30%);
}

.control-btn.active {
  background: #ff4655;
  border-color: #ff4655;
}

.map-area,
.map-touch-view {
  width: 100%;
  height: 100%;
  overflow: hidden;
  transform-origin: center center;
}
.map-base-img {
  width: 100%;
  height: 100%;
  pointer-events: none;
  display: block;
}

/* 点位动画 */
.map-pointer {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  transform: translate(-50%, -50%);
  z-index: 50;
}
.pointer-core {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin: 14rpx auto;
  border: 4rpx solid #fff;
}
.atk .pointer-core {
  background: #ff4655;
  box-shadow: 0 0 15rpx #ff4655;
}
.def .pointer-core {
  background: #00eeff;
  box-shadow: 0 0 15rpx #00eeff;
}

/* ==========================================
   纵向列表：图片与备注
   ========================================== */
.vertical-item-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.tactical-item {
  background: rgba(236, 232, 225, 0.02);
  border-left: 2rpx solid rgba(255, 70, 85, 0.2);
  padding: 15rpx;
}

.fixed-size {
  width: 100%;
  height: 400rpx;
  background: #1f2326;
  position: relative;
}

.fixed-size image {
  width: 100%;
  height: 100%;
}

.item-del-btn {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  background: #ff4655;
  color: #fff;
  font-size: 18rpx;
  padding: 6rpx 18rpx;
  font-weight: 900;
  clip-path: polygon(10% 0, 100% 0, 100% 70%, 90% 100%, 0 100%, 0 30%);
}

.item-textarea {
  width: 100%;
  min-height: 80rpx;
  background: rgba(0, 0, 0, 0.2);
  color: #ece8e1;
  font-size: 26rpx;
  padding: 15rpx;
  box-sizing: border-box;
}

/* 空状态占位与追加按钮 */
.placeholder-border {
  border: 2rpx dashed rgba(236, 232, 225, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  font-size: 60rpx;
  color: rgba(236, 232, 225, 0.2);
}

.add-next-bar {
  width: 100%;
  height: 80rpx;
  background: rgba(236, 232, 225, 0.05);
  border: 1rpx solid rgba(236, 232, 225, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  color: #ff4655;
  letter-spacing: 2rpx;
}

.custom-textarea {
  width: 100%;
  height: 200rpx;
  background: rgba(236, 232, 225, 0.05);
  border: 1rpx solid rgba(236, 232, 225, 0.2);
  padding: 20rpx;
  color: #ece8e1;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ==========================================
   底部双按钮栏
   ========================================== */
.submit-bar {
  padding: 30rpx 40rpx;
  /* padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); */
  background: #0f1923;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  width: 180rpx;
  height: 100rpx;
  border: 2rpx solid #ff4655;
  color: #ff4655;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  /* clip-path: polygon(0 0, 100% 0, 100% 70%, 85% 100%, 0 100%); */
}

.btn-primary {
  flex: 1;
  height: 100rpx;
  background: #ff4655;
  /* clip-path: polygon(5% 0, 100% 0, 100% 75%, 95% 100%, 0 100%, 0 25%); */
}

.btn-inner {
  line-height: 100rpx;
  text-align: center;
  color: #fff;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.footer-spacer {
  height: 80rpx;
}
.ph-style {
  color: rgba(236, 232, 225, 0.2);
}

/* 1. 统一容器盒子模型 */
.custom-input,
.custom-textarea {
  width: 100%;
  box-sizing: border-box; /* 必须：包含边框和内边距 */
  background: rgba(236, 232, 225, 0.05);
  border: 1rpx solid rgba(236, 232, 225, 0.2);
  color: #ece8e1;
  font-size: 28rpx;
  padding: 24rpx !important; /* 强制统一内边距 */
  margin: 0; /* 清除可能的外部间距 */
  display: block; /* 确保块级显示 */
}

/* 2. 解决标题 Input 的高度 */
.title-input {
  height: 90rpx;
  min-height: 90rpx;
  border-bottom: 4rpx solid #ff4655; /* 瓦罗兰特红底边 */
}

/* 3. 解决 Textarea 的原生偏移 */
.custom-textarea {
  height: 220rpx;
  /* 微信原生 textarea 默认会有一些内边距，这里尝试抵消 */
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* 4. 强制 Placeholder 颜色和字体一致 */
.ph-style {
  color: rgba(236, 232, 225, 0.2) !important;
  font-size: 28rpx !important; /* 确保和输入文字大小一致 */
  font-family: inherit;
}

/* 针对部分机型 textarea 的 placeholder 偏移补丁 */
textarea.custom-textarea {
  margin-left: 0;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}

.label-hint {
  font-size: 18rpx;
  color: rgba(255, 70, 85, 0.5);
  font-weight: bold;
  letter-spacing: 2rpx;
}

.video-link-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.link-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #ff4655; /* 既然是视频号链接，颜色给亮一点，突出它 */
}

.how-to-get {
  width: 60rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 70, 85, 0.1);
  color: #ff4655;
  font-weight: bold;
  border-left: 1rpx solid rgba(255, 70, 85, 0.2);
}

/* 特工选择框内部布局 */
.agent-select-inner {
  display: flex;
  align-items: center;
  flex: 1;
}

.mini-agent-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.1);
}

.placeholder-text {
  color: #8b9196;
}

.arrow-down {
  font-size: 18rpx;
  color: #ff4655;
  margin-left: 10rpx;
}

/* 之前你代码里的 align-height 确保高度统一 */
.align-height {
  height: 90rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
