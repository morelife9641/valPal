.detail-container {
  width: 100%;
  height: 100vh;
  background-color: #0f1923;
  position: relative;
  overflow: hidden;
}

/* 背景层 */
.page-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.empty-bg-portrait {
  width: 100%;
  height: 100%;
  opacity: 0.12; /* 稍微调低一点，保证上方文字清晰 */
  filter: grayscale(1);
}

.empty-bg-portrait image {
  width: 100%;
  height: 100%;
}

/* 列表容器 */
.strategy-list {
  padding: 30rpx;
  box-sizing: border-box;
}

/* 卡片主体 */
.strategy-card {
  display: flex;
  height: 180rpx;
  background: #1f2326;
  margin-bottom: 24rpx;
  position: relative;
  border-left: 6rpx solid #383e44; /* 默认深灰边 */
  transition: all 0.2s ease;
  clip-path: polygon(0 0, 100% 0, 100% 88%, 96% 100%, 0 100%);
}

/* 激活状态/点击反馈 */
.strategy-card:active {
  border-left-color: #ff4655;
  transform: translateX(10rpx);
}

/* 左侧预览区 */
.card-visual {
  width: 220rpx;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
  filter: grayscale(20%);
}

.visual-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(31, 35, 38, 0.8));
}

.type-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 18rpx;
  color: #ece8e1;
  background: rgba(0, 0, 0, 0.6);
  padding: 2rpx 10rpx;
  border: 1rpx solid #383e44;
}

/* 右侧内容区 */
.card-content {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.strategy-title {
  display: block;
  color: #ece8e1;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.strategy-subtitle {
  font-size: 16rpx;
  color: #8b9196;
  letter-spacing: 2rpx;
}

.bottom-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-box {
  display: flex;
  align-items: center;
  font-size: 18rpx;
  color: #5d6369;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  background: #00ffbb; /* 这种青绿色代表激活状态 */
  margin-right: 10rpx;
  border-radius: 50%;
}

.action-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid #ff4655;
  border-right: 2rpx solid #ff4655;
  transform: rotate(45deg);
}

/* 装饰细节 */
.card-deco {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 20rpx 20rpx 0;
  border-color: transparent #383e44 transparent transparent;
}

.portrait-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* 渐变遮罩：四周暗，中间略透，防止背景图片边缘太生硬 */
  background:
    radial-gradient(circle at center, transparent, #0f1923 80%),
    linear-gradient(to bottom, #0f1923 5%, transparent 40%, #0f1923 95%);
}

/* 内容层 */
.content-wrapper {
  position: relative;
  z-index: 5;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 60rpx 0 40rpx;
}

.hero-name-en {
  font-size: 48rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.05);
  position: absolute;
  top: 40rpx;
  left: 40rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: bold;
  color: #ece8e1;
  border-left: 6rpx solid #ff4655;
  padding-left: 20rpx;
}

/* 上传按钮样式 */
.header-action {
  position: relative;
  width: 160rpx;
  height: 64rpx;
}

.btn-skew-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #ff4655;
  transform: skewX(-15deg);
}

.btn-content {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

/* 缺省提示 */
.empty-content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: -100rpx;
}

.err-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #ff4655;
  letter-spacing: 4rpx;
}

.err-hint {
  font-size: 24rpx;
  color: #8b978f;
  margin: 20rpx 0 60rpx;
}

.empty-btn {
  padding: 24rpx 60rpx;
  border: 1rpx solid #ff4655;
  color: #ff4655;
  font-size: 24rpx;
  font-weight: bold;
  clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
}
