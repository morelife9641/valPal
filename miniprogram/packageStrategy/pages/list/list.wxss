.detail-container {
  min-height: 100vh;
  background-color: #0f1923;
  padding-top: 120rpx; /* 为顶部固定栏留位置 */
}

/* 顶部筛选栏 */
.filter-sticky-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(15, 25, 35, 0.95);
  backdrop-filter: blur(10px);
  z-index: 100;
  border-bottom: 1rpx solid rgba(236, 232, 225, 0.1);
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.filter-row {
  display: flex;
  width: 100%;
  gap: 20rpx;
}
.flex-1 {
  flex: 1;
}
.flex-2 {
  flex: 2;
}

.filter-item {
  background: rgba(236, 232, 225, 0.05);
  height: 70rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(236, 232, 225, 0.1);
}

.filter-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
}

.filter-inner .label {
  color: rgba(236, 232, 225, 0.4);
  margin-right: 10rpx;
}
.filter-inner .value {
  color: #ece8e1;
  font-weight: 900;
}
.filter-inner .value.atk {
  color: #ff4655;
}
.filter-inner .value.def {
  color: #00eeff;
}

/* 卡片布局 - 增加图片占比 */
.strategy-list {
  padding: 20rpx 30rpx;
}

/* 卡片基础：增加一点外边距和圆角感 */
.strategy-card {
  display: flex;
  height: 240rpx; /* 再次微调高度，平衡比例 */
  background: #1f2326;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(236, 232, 225, 0.1);
  position: relative;
  clip-path: polygon(0 0, 100% 0, 100% 88%, 97% 100%, 0 100%);
}

.card-left {
  width: 200rpx; /* 增加图片宽度到 200rpx */
  height: 100%;
  position: relative;
  flex-shrink: 0;
  background: #000;
}

.map-preview-img {
  width: 100%;
  height: 100%;
  opacity: 0.7; /* 稍微压低亮度，突出 Tag */
}

/* --- 新增：文字 Tag 样式 --- */
.side-tag-label {
  position: absolute;
  top: 0;
  left: 0;
  padding: 4rpx 15rpx;
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  z-index: 10;
  /* 瓦罗兰特式的斜切感 */
  clip-path: polygon(0 0, 100% 0, 85% 100%, 0 100%);
}

/* 进攻方：红底白字 */
.side-tag-label.atk {
  background: #ff4655;
  color: #fff;
}

/* 防守方：青蓝底黑字（高对比） */
.side-tag-label.def {
  background: #00eeff;
  color: #0f1923;
}

/* 侧边颜色指示条 */
.side-indicator {
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  z-index: 5;
}
.side-indicator.atk {
  background: #ff4655;
  box-shadow: 0 0 15rpx #ff4655;
}
.side-indicator.def {
  background: #00eeff;
  box-shadow: 0 0 15rpx #00eeff;
}

/* --- 右侧内容区域优化 --- */
.card-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #ece8e1;
  display: block;
  margin-bottom: 4rpx;
}

.card-map-name {
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(236, 232, 225, 0.4);
  text-transform: uppercase;
}

.stat-group {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-item .num {
  font-size: 32rpx;
  font-weight: 900;
  color: #ece8e1;
  line-height: 1;
}

.stat-item .lab {
  font-size: 14rpx;
  color: #ff4655;
  font-weight: 700;
  margin-top: 6rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.view-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 18rpx;
  font-weight: 900;
  color: #ff4655;
  border-bottom: 1rpx solid #ff4655;
  padding-bottom: 4rpx;
}

.card-map-name {
  font-size: 18rpx;
  color: #ff4655;
  text-transform: uppercase;
  font-weight: 700;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.date {
  font-size: 18rpx;
  color: rgba(236, 232, 225, 0.2);
  font-family: monospace;
}

.go-btn {
  font-size: 18rpx;
  font-weight: 900;
  color: #ff4655;
  border-bottom: 2rpx solid #ff4655;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #ff4655;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(255, 70, 85, 0.4);
}
