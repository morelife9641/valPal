<view class="detail-container">
    <view class="filter-sticky-bar">
        <view class="filter-row">
            <picker class="filter-item flex-2" bindchange="onMapFilterChange" value="{{mapIndex}}" range="{{maps}}" range-key="displayName">
                <view class="filter-inner">
                    <text class="label">地图</text>
                    <text class="value">{{maps[mapIndex].displayName || '全部'}}</text>
                    <view class="arrow-down"></view>
                </view>
            </picker>
            <view class="filter-item flex-1" bindtap="toggleSideFilter">
                <view class="filter-inner">
                    <text class="label">阵营</text>
                    <text class="value {{sideFilter}}">
                        {{sideFilter === 'all' ? '全部' : (sideFilter === 'atk' ? '进攻' : '防守')}}
                    </text>
                </view>
            </view>
        </view>
    </view>
    <view class="content-scroll-box">
        <view class="strategy-list">
            <view class="strategy-card" wx:for="{{filteredList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
                <view class="card-left">
                    <image src="{{item.mapThumb}}" mode="aspectFill" class="map-preview-img" />
                    <view class="side-tag-label {{item.side}}">
                        <text>{{item.side === 'atk' ? 'ATTACK' : 'DEFEND'}}</text>
                    </view>
                    <view class="side-indicator {{item.side}}"></view>
                </view>
                <view class="card-right">
                    <view class="card-header">
                        <view class="title-row">
                            <text class="card-title">{{item.title}}</text>
                        </view>
                        <text class="card-map-name">{{item.mapName}}</text>
                    </view>
                    <view class="card-body">
                        <view class="stat-group">
                            <view class="stat-item">
                                <text class="num">{{item.markPoints.length || 0}}</text>
                                <text class="lab">MARKS</text>
                            </view>
                            <view class="stat-item">
                                <text class="num">
                                    {{item.standImg.length + (item.enemyImg ? item.enemyImg.length : 0)}}
                                </text>
                                <text class="lab">RECORDS</text>
                            </view>
                        </view>
                    </view>
                    <view class="card-footer">
                        <text class="date">{{item.dateDisplay}}</text>
                        <view class="view-action">
                            <text>DETAILS</text>
                            <view class="arrow-mini"></view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="empty-hint" wx:if="{{filteredList.length === 0}}">
            <text>未发现相关战术部署</text>
        </view>
    </view>
    <view class="fab-btn" bindtap="goToAdd">
        <text>+</text>
    </view>
</view>