<view class="detail-container">
    <view class="header-filter-row">
        <view class="filter-btns">
            <view class="filter-view-btn {{isFavoriteOnly ? 'active' : ''}}" bindtap="toggleFavoriteFilter">
                <view class="btn-content">
                    <text class="btn-label">收藏</text>
                    <text class="btn-value">{{isFavoriteOnly ? '已收藏' : '全部'}}</text>
                </view>
            </view>
            <picker class="filter-view-btn {{filterMap.uuid ? 'active' : ''}}" bindchange="onMapChange" value="{{mapIndex}}" range="{{maps}}" range-key="displayName">
                <view class="btn-content">
                    <text class="btn-label">地图</text>
                    <text class="btn-value">{{filterMap.displayName || '全部地图'}}</text>
                </view>
                <view wx:if="{{filterMap.uuid}}" class="clear-icon" catchtap="clearMapFilter">
                    ✕
                </view>
            </picker>
            <picker class="filter-view-btn {{filterSideLabel!== '全部'?'active':''}}" bindchange="onSideChange" value="{{mapIndex}}" range="{{sideOptions}}" range-key="name">
                <view class="btn-content">
                    <text class="btn-label">阵营</text>
                    <text class="btn-value">{{filterSideLabel || '全部'}}</text>
                </view>
                <view wx:if="{{filterSideLabel!== '全部'}}" class="clear-icon" catchtap="clearSideFilter">
                    ✕
                </view>
            </picker>
            <picker class="filter-view-btn {{pointType !== '' ? 'active' : ''}}" bindchange="onPointChange" value="{{pointIndex}}" range="{{pointOptions}}" range-key="name">
                <view class="btn-content">
                    <text class="btn-label">位置</text>
                    <text class="btn-value">{{filterPointLabel}}</text>
                </view>
                <view wx:if="{{pointType !== ''}}" class="clear-icon" catchtap="clearPointFilter">
                    ✕
                </view>
            </picker>
        </view>
        <view class="add-btn-wrap" bindtap="goToAdd">
            <view class="add-icon">+</view>
        </view>
    </view>
    <view class="content-scroll-box">
        <view class="strategy-list">
            <view class="strategy-card {{item.side}}" wx:for="{{filteredList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
                <view class="card-left">
                    <image src="{{item.mapThumb}}" mode="aspectFill" class="map-preview-img" />
                </view>
                <view class="card-right">
                    <view class="card-top-row">
                        <text class="card-title">{{item.title}}</text>
                        <view class="favorite-star {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-id="{{item._id}}">
                            {{item.isFavorite ? '★' : '☆'}}
                        </view>
                    </view>
                    <view class="card-mid-row">
                        <text class="map-label">{{item.mapName}}</text>
                        <view class="point-tag">{{item.pointType || '其他'}}</view>
                    </view>
                    <view class="card-bottom-row">
                        <text class="side-text {{item.side}}">
                            {{item.side === 'atk' ? '攻方' : '守方'}}
                        </text>
                        <text class="date-text">{{item.dateDisplay}}</text>
                    </view>
                </view>
            </view>
