.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #0f1923; /* 换成深青黑 */
  backdrop-filter: blur(15px); /* 毛玻璃效果 */
  display: flex;
  padding: 10px 0;
  /* padding-bottom: env(safe-area-inset-bottom); */
  border-top: 1rpx solid rgba(255, 255, 255, 0.1); /* 极细的半透明边框 */
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #8a8a8a; /* 未选中用中灰色 */
  font-weight: bold;
  text-transform: uppercase; /* 英文全大写更有电竞感 */
}
.tab-text.active {
  color: #ff4655;
  font-weight: bold;
}

.active-line {
  width: 30rpx;
  height: 4rpx;
  background: #ff4655;
  margin-top: 6rpx;
  border-radius: 2rpx;
}
