.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #0f1923; /* 瓦式深青黑 */
  backdrop-filter: blur(15px); /* 毛玻璃 */
  display: flex;
  padding: 10px 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  z-index: 9999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.2s ease;
}

/* 顶部红色指示条：抵消外层 padding 贴顶 */
.active-line {
  position: absolute;
  top: -10px;
  width: 40rpx;
  height: 4rpx;
  background: #ff4655;
  box-shadow:
    0 0 10rpx #ff4655,
    0 0 20rpx rgba(255, 70, 85, 0.5);
}

/* 选中后的微弱红光背景 */
.active-glow {
  position: absolute;
  top: -10px;
  bottom: -10px;
  left: 0;
  right: 0;
  background: linear-gradient(to bottom, rgba(255, 70, 85, 0.08), transparent);
  pointer-events: none;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
  transition: transform 0.2s ease;
  opacity: 0.5;
}

.tab-bar-item.active .tab-icon {
  opacity: 1;
  transform: translateY(-2rpx); /* 选中时微抬 */
}

.tab-text {
  font-size: 20rpx;
  color: #8b9196;
  font-weight: bold;
  letter-spacing: 1rpx;
  position: relative;
}

.tab-bar-item.active .tab-text {
  color: #ece8e1;
}

/* 文本装饰 // */
.deco-dots {
  position: absolute;
  right: -24rpx;
  top: 0;
  color: #ff4655;
  font-size: 16rpx;
  font-style: italic;
  font-weight: 900;
}

/* 点击时的触感反馈 */
.tab-bar-item:active {
  opacity: 0.7;
}
