{
  "pages": [
    "pages/strategy/index",
    "pages/news/index",
    "pages/skins/index",
    "pages/tools/index",
    "components/card-selector/card-selector",
    "components/rank-picker/rank-picker",
    "components/login-popup/login-popup",
    "pages/valo_news/index",
    "pages/valo_news/detail",
    "pages/valo_news/edit"
  ],
  "subpackages": [
    {
      "root": "packageStrategy",
      "name": "strategyDetail",
      "pages": [
        "pages/detail/detail",
        "pages/list/list",
        "pages/add-point/add-point"
      ]
    },
    {
      "root": "packageWallpaper",
      "name": "wallpaperEditor",
      "pages": [
        "pages/wallpaper/wallpaper",
        "pages/display/display",

        "pages/preview/preview"
      ]
    },
    {
      "root": "packageTools",
      "name": "toolsWiki",
      "pages": [
        "pages/crosshair/list",
        "pages/pro-settings/list",
        "pages/pro-settings/detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/strategy/index": {
      "network": "all",
      "packages": ["packageStrategy"]
    }
  },
  "window": {
    "navigationBarTitleText": "瓦库库",
    "navigationBarBackgroundColor": "#0F1923",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#0F1923"
  },
  "tabBar": {
    "color": "#8a8a8a",
    "selectedColor": "#ff4655",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "custom": true,
    "list": [
      {
        "pagePath": "pages/strategy/index",
        "text": "首页",
        "iconPath": "assets/index.png",
        "selectedIconPath": "assets/index_active.png"
      },
      {
        "pagePath": "pages/news/index",
        "text": "资讯",
        "iconPath": "assets/公开比赛 (1).png",
        "selectedIconPath": "assets/公开比赛.png"
      },
      {
        "pagePath": "pages/skins/index",
        "text": "皮肤",
        "iconPath": "assets/skin.png",
        "selectedIconPath": "assets/skin_active.png"
      },
      {
        "pagePath": "pages/tools/index",
        "text": "我的",
        "iconPath": "assets/个人 (1).png",
        "selectedIconPath": "assets/个人.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json"
}
