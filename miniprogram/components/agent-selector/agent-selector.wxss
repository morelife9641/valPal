/* 1. 弹出层容器：加入缩放效果 */
.portal-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 9999;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7); /* 半透明黑，很有代入感 */
  backdrop-filter: blur(4px); /* 可选：给背景加一点点毛玻璃，更硬核 */
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}

.mask.show {
  opacity: 0.3;
}

.bottom-popup {
  position: relative;
  z-index: 2;
  background: #0f1923;
  border-top: 4rpx solid #ff4655;

  /* --- 核心修改：设置定高 --- */
  height: 380rpx; /* 根据你的 UI 比例调整，建议 400-500rpx 之间 */
  display: flex;
  flex-direction: column; /* 纵向排列 Tab 和 列表 */

  /* padding-bottom: env(safe-area-inset-bottom); */
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* 2. 显示态：恢复原状 */
.bottom-popup.show {
  transform: translateY(0);
}

/* 3. 内部英雄卡片：入场动画 */
.item-card {
  opacity: 0;
  transform: translateX(40rpx); /* 从右侧滑入 */
  transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 当父级 show 时，所有卡片滑入 */
.bottom-popup.show .item-card {
  opacity: 1;
  transform: translateX(0);
}

.popup-header {
  /* height: 100rpx; */
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 70, 85, 0.1) 0%,
    transparent 100%
  );
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.popup-header text {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

/* 横向滚动区域 */
.selector-view {
  width: 100%;
  white-space: nowrap;
  height: 100%;
  overflow: hidden;
}

.item-list {
  height: 100%;
  display: inline-flex;
  align-items: center;
}

/* 英雄卡片 */
.item-card {
  display: inline-flex !important;
  flex-direction: column !important;
  align-items: center !important;
  width: 120rpx !important;
  margin: 0 20rpx !important;
  position: relative !important;
  flex-shrink: 0;
}

.item-card image {
  width: 140rpx !important;
  height: 140rpx !important;
  background-color: #1f2326 !important;
  border: 2rpx solid rgba(255, 255, 255, 0.1) !important;
  /* 模拟游戏里的切角矩形头像框 */
  /* clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%) !important; */
  transition: all 0.3s !important;
}

.item-card text {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8b8b8b;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* 选中态：红色高亮 */
.item-card.selected image {
  border: 4rpx solid #ff4655;
  background: linear-gradient(135deg, rgba(255, 70, 85, 0.3) 0%, #1f2326 100%);
  /* transform: translateY(-10rpx); */
}

.item-card.selected text {
  color: #ff4655;
}

/* 卡片背后增加一个微弱的序号或装饰文本 */
.item-card::before {
  content: "//";
  position: absolute;
  top: -10rpx;
  right: 20rpx;
  font-size: 18rpx;
  color: rgba(255, 70, 85, 0.3);
}

.tabs-fixed-row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.tab-pill {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 15rpx 0;
  margin: 0 5rpx;
  background: rgba(255, 255, 255, 0.03);
  transition: all 0.2s;
  text-transform: uppercase;
  /* clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);  */
}

.tab-pill.active {
  background: #ff4655;
  color: #fff;
  font-weight: bold;
}

.empty-hint {
  padding: 100rpx;
  color: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

/* 缺省页容器 */
.empty-hint-container {
  width: 100vw; /* 占据整个滚动区域宽度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* padding: 80rpx 0; */
}

/* 装饰性图标 */
.empty-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border: 1px solid rgba(255, 70, 85, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 0;
  background: rgba(255, 70, 85, 0.05);
}

/* 扫描线动画 */
.scan-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #ff4655;
  box-shadow: 0 0 10rpx #ff4655;
  animation: scanMove 2s infinite ease-in-out;
}

@keyframes scanMove {
  0% {
    top: 0;
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    top: 100%;
    opacity: 0;
  }
}

.glitch-text {
  font-weight: bold;
  color: rgba(255, 255, 255, 0.1);
  font-size: 32rpx;
}

/* 文字提示 */
.main-hint {
  font-size: 20rpx;
  color: #ece8e1;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  font-weight: bold;
}

.sub-hint {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 1. 定义动画基类 */
.bottom-popup.show .item-card {
  animation: slideIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 2. 动画帧：稍微增加了一点缩放，让它更有弹性感 */
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 3. 阶梯式延迟（Staggered Delay） */
/* 为前 10 个特工设置不同的延迟，后面的直接显示 */
.item-card:nth-child(1) {
  animation-delay: 0.05s;
}
.item-card:nth-child(2) {
  animation-delay: 0.1s;
}
.item-card:nth-child(3) {
  animation-delay: 0.15s;
}
.item-card:nth-child(4) {
  animation-delay: 0.2s;
}
.item-card:nth-child(5) {
  animation-delay: 0.25s;
}
.item-card:nth-child(6) {
  animation-delay: 0.3s;
}
.item-card:nth-child(7) {
  animation-delay: 0.35s;
}
.item-card:nth-child(8) {
  animation-delay: 0.4s;
}
