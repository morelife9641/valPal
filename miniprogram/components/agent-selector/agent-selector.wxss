/* 遮罩层 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 25, 35, 0.85);
  backdrop-filter: blur(4px);
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}
.popup-mask.show {
  visibility: visible;
  opacity: 1;
}

/* 弹出容器 */
.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 70vh;
  background: #1f2326;
  border-top: 6rpx solid #ff4655;
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  display: flex;
  flex-direction: column;
}
.show .popup-content {
  transform: translateY(0);
}

/* 头部 */
.p-header {
  padding: 20rpx 30rpx;
  background: #0f1923;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.p-title {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.p-close {
  color: #8b9196;
  font-size: 36rpx;
  padding: 10rpx;
}

/* Tab 切换行 */
.tabs-fixed-row {
  display: flex;
  /* padding: 20rpx 30rpx; */
  /* gap: 15rpx; */
  background: #1f2326;
}
.tab-pill {
  flex: 1;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #8b9196;
  /* background: rgba(255, 255, 255, 0.05); */
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s;
  letter-spacing: 2rpx;
  text-align: center;
}
.tab-pill.active {
  background: #ff4655;
  color: #ece8e1;
  border-color: #ff4655;
}

/* 列表容器 */
.rank-scroll {
  flex: 1;
  overflow-y: hidden;
}
.grid-container {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 40rpx;
}

/* 特工项 */
.rank-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  box-sizing: border-box;
  border: 2rpx solid rgba(236, 232, 225, 0.03);
  transition: all 0.2s;
}

.rank-item.active {
  background: rgba(255, 70, 85, 0.1);
  border-color: rgba(255, 70, 85, 0.3);
  box-shadow: inset 0 0 20rpx rgba(255, 70, 85, 0.1);
}

.rank-img {
  width: 100rpx; /* 特工头像比段位图标大一点 */
  height: 100rpx;
  filter: drop-shadow(0 0 10rpx rgba(0, 0, 0, 0.3));
}

.rank-txt {
  color: #ece8e1;
  font-size: 24rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.empty-hint {
  width: 100%;
  padding: 100rpx 0;
  text-align: center;
  color: #8b9196;
  font-size: 24rpx;
}
