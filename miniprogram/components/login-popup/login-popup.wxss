.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  z-index: 9999;
}
.login-mask.show {
  opacity: 1;
  visibility: visible;
}

.login-container {
  width: 600rpx;
  background: #1f2326;
  border: 1rpx solid #383e44;
  padding: 50rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-text {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  font-size: 100rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.02);
  font-style: italic;
  pointer-events: none;
}

.login-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.red-bar {
  width: 8rpx;
  height: 36rpx;
  background: #ff4655;
  margin-right: 20rpx;
}
.title {
  color: #ece8e1;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.login-content {
  margin-bottom: 50rpx;
}
.desc-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}
.dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff4655;
  margin-right: 15rpx;
  transform: rotate(45deg);
}
.desc-item text {
  color: #8b9196;
  font-size: 24rpx;
}

/* 表单样式 */
.input-group {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.label {
  color: #8b9196;
  font-size: 26rpx;
  width: 100rpx;
}

.avatar-wrapper {
  background: none;
  padding: 0;
  margin: 0;
  width: 80rpx;
  height: 80rpx;
  position: relative;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 4rpx;
}
.edit-icon {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: rgba(255, 70, 85, 0.8);
  color: white;
  font-size: 16rpx;
  text-align: center;
}

.nickname-input {
  flex: 1;
  color: #ece8e1;
  font-size: 28rpx;
  padding-left: 20rpx;
}

.submit-btn {
  margin-top: 50rpx;
  background: #ff4655;
  color: #ece8e1;
  font-weight: bold;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  position: relative;
}
.btn-deco {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 0;
  height: 0;
  border-bottom: 20rpx solid #1f2326;
  border-left: 20rpx solid transparent;
}

.login-header {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 关键：左右撑开 */
  margin-bottom: 40rpx;
  width: 100%;
}

/* 左侧包装容器：红条和文字水平排列 */
.header-left {
  display: flex;
  align-items: center;
}

.red-bar {
  width: 8rpx;
  height: 36rpx;
  background: #ff4655;
  margin-right: 20rpx;
}

.title {
  color: #ece8e1;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 右侧关闭按钮样式优化 */
.close-btn {
  color: #8b9196;
  font-size: 44rpx; /* 稍微大一点，方便点击 */
  padding: 10rpx; /* 增加点击热区 */
  line-height: 1;
  transition: color 0.2s;
}

.close-btn:active {
  color: #ff4655; /* 点击时变红反馈 */
}
