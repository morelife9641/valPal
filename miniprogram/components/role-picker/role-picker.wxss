/* role-popup.wxss */

/* 1. 遮罩层：全屏毛玻璃深蓝色调 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 25, 35, 0.85); /* 瓦罗兰特招牌深蓝底色 */
  backdrop-filter: blur(8px); /* 强化模糊感，突出弹窗 */
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.popup-mask.show {
  visibility: visible;
  opacity: 1;
}

/* 2. 弹出容器：底部滑入，高度自适应 */
.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  /* height: 35vh;  */
  background: #1f2326;
  border-top: 6rpx solid #ff4655; /* 标志性的瓦红顶边 */
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.5);
}

.show .popup-content {
  transform: translateY(0);
}

/* 3. 头部标题栏 */
.p-header {
  padding: 20rpx 30rpx;
  background: #0f1923;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.p-title {
  color: #ece8e1;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.p-close {
  color: #8b9196;
  font-size: 36rpx;
  padding: 10rpx;
  line-height: 1;
}

/* 4. 职业选择滚动/排列区域 */
.role-scroll {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap; /* 自动换行 */
  /* padding: 40rpx 10rpx; */
  box-sizing: border-box;
  justify-content: flex-start;
}

/* 🚩 5. 职业项：核心一行五个 (20% 宽度) */
.role-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  /* 基础边框极淡 */
  border: 1rpx solid rgba(236, 232, 225, 0.02);
}

/* 选中状态：淡红晕染反馈 */
.role-item.active {
  background: rgba(255, 70, 85, 0.1);
  border-color: rgba(255, 70, 85, 0.3);
}

/* 职业图标样式 */
.role-img {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.6; /* 未选中时降暗 */
  transition: all 0.3s ease;
  filter: drop-shadow(0 0 2rpx rgba(0, 0, 0, 0.8));
}

.role-item.active .role-img {
  opacity: 1;
  transform: scale(1.2) translateY(-4rpx); /* 选中时放大上移 */
  filter: drop-shadow(0 0 10rpx rgba(255, 70, 85, 0.6)); /* 红光外发光 */
}

/* 职业文字样式 */
.role-txt {
  color: #8b9196;
  font-size: 20rpx;
  font-weight: bold;
  margin-top: 20rpx;
  letter-spacing: 1rpx;
  transition: color 0.3s;
}

.role-item.active .role-txt {
  color: #ff4655; /* 选中文字变瓦红 */
  text-shadow: 0 0 10rpx rgba(255, 70, 85, 0.2);
}

/* 6. 选中装饰：底部中心小红点 */
.active-dot {
  position: absolute;
  bottom: 15rpx;
  width: 16rpx;
  height: 4rpx;
  background: #ff4655;
  border-radius: 2rpx;
  box-shadow: 0 0 6rpx #ff4655;
}

/* 点击时的即时缩小反馈 */
.role-item:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.05);
}

/* 屏蔽滚动条显示 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
