/* 强制全屏容器 */
.card-modal {
  position: fixed;
  inset: 0;
  z-index: 99999 !important; /* 极高优先级 */
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.85); /* 颜色加深 */
  z-index: 1;
}

.modal-content {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 75vh;
  background: #0f1923;
  border-top: 4rpx solid #ff4655;

  /* 暂时取消动画，直接显示，排除动画不触发的问题 */
  transform: translateY(0);

  display: flex;
  flex-direction: column;
  /* padding-bottom: env(safe-area-inset-bottom); */
}

/* 布局：一行四个 */
.card-scroll {
  flex: 1;
  height: 1px;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx;
  box-sizing: border-box;
}

.card-grid-item {
  width: 25%;
  padding: 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  animation: cardSlideIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes cardSlideIn {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.card-grid-item:nth-child(1) {
  animation-delay: 0.05s;
}
.card-grid-item:nth-child(2) {
  animation-delay: 0.1s;
}
.card-grid-item:nth-child(3) {
  animation-delay: 0.15s;
}
.card-grid-item:nth-child(4) {
  animation-delay: 0.2s;
}
.card-grid-item:nth-child(5) {
  animation-delay: 0.25s;
}
.card-grid-item:nth-child(6) {
  animation-delay: 0.3s;
}
.card-grid-item:nth-child(7) {
  animation-delay: 0.35s;
}
.card-grid-item:nth-child(8) {
  animation-delay: 0.4s;
}

.card-thumb {
  width: 100%;
  height: 240rpx;
  background: #2a2a2a;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.card-grid-item.active .card-thumb {
  border: 2rpx solid #ff4655;
}

.card-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8b978f;
  text-align: center;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-box {
  padding: 8rpx 40rpx;
  margin-top: 8rpx;
}

.search-box {
  padding: 30rpx 30rpx 20rpx;
  background: #0f1923; /* 保持与主体一致 */
}

.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  /* 瓦罗兰特锐利风格：切角感 */
  /* clip-path: polygon(0 0, 98% 0, 100% 30%, 100% 100%, 2% 100%, 0 70%); */
  padding: 0 20rpx;
  height: 84rpx;
  transition: all 0.2s ease;
}

/* 输入框聚焦时的光效（模拟） */
.search-wrapper:active,
.search-wrapper:focus-within {
  border-color: rgba(255, 70, 85, 0.5);
  background: rgba(255, 255, 255, 0.08);
}

.search-icon-left {
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  color: #fff;
  font-size: 26rpx;
}

.clear-btn {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 优化卡面列表顶部的间距，防止搜索栏挡住内容 */
.card-scroll {
  padding-top: 10rpx;
}

/* 重置项图标 */
.default-bg {
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-reset {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ff4655;
  border-radius: 50%;
}
