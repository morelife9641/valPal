/* 遮罩层：毛玻璃效果 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 25, 35, 0.85); /* 瓦罗兰特深蓝底色 */
  backdrop-filter: blur(4px);
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}
.popup-mask.show {
  visibility: visible;
  opacity: 1;
}

.item-overlay {
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.8) 0%,
    rgba(0, 0, 0, 0.2) 60%
  );
  display: flex;
  flex-direction: column;
  justify-content: flex-end; /* 文字靠底部 */
  /* padding: 15rpx 20rpx; */
  box-sizing: border-box;
}

/* 弹出容器：占屏幕 40% */
.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  /* height: 36vh;  */
  background: #1f2326;
  border-top: 6rpx solid #ff4655;
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  display: flex;
  flex-direction: column;
}
.show .popup-content {
  transform: translateY(0);
}

/* 头部设计 */
.p-header {
  padding: 14rpx 30rpx;
  background: #0f1923;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.p-title {
  color: #ece8e1;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.p-close {
  color: #8b9196;
  font-size: 32rpx;
  padding: 10rpx;
}

/* 滚动区域 */
.rank-scroll {
  display: flex;
  flex-direction: row; /* 横向排列 */
  flex-wrap: wrap; /* 自动换行 */
  /* padding: 20rpx 10rpx; */
  box-sizing: border-box;
}

.rank-item {
  width: 33.3%; /* 留出 gap 空间，三列建议用 31% */
  height: 140rpx;
  position: relative;
  /* margin-bottom: 12rpx; */
  box-sizing: border-box;

  /* 🚩 核心修改 1：重回 cover，确保上下不留白 */
  background-size: cover;

  /* 🚩 核心修改 2：锁定垂直位置在 30%，通常地图的精华（地平线）都在偏上方 */
  /* 如果觉得太靠上，可以改回 50% */
  background-position: 50% 30%;

  background-repeat: no-repeat;
  background-color: #0f1923;
  /* filter: grayscale(0.3) brightness(0.7); */
  /* 保持硬核边框和切角 */
  /* border: 1rpx solid rgba(255, 255, 255, 0.1); */
  overflow: hidden;
  /* clip-path: polygon(0 0, 100% 0, 100% 85%, 90% 100%, 0 100%); */
}

.item-overlay {
  /* 🚩 增加遮罩深度，让文字在复杂的背景图上更稳 */
  background: linear-gradient(
    to top,
    rgba(15, 25, 35, 0.9) 0%,
    rgba(15, 25, 35, 0.2) 100%
  );
}

.rank-item.active {
  filter: grayscale(0) brightness(1.1); /* 恢复色彩并提亮 */
  /* border: 2rpx solid #ff4655; */
  box-shadow: 0 0 20rpx rgba(255, 70, 85, 0.4); /* 呼吸感红光 */
  /* transform: translateY(-4rpx); 悬浮感 */
  z-index: 10;
}

.rank-item.active .item-overlay {
  /* 🚩 选中时爆发出红色叠加层 */
  /* 使用 multiply 或 overlay 效果的红色渐变 */
  background: linear-gradient(
    135deg,
    rgba(255, 70, 85, 0.7) 0%,
    /* 亮红色 */ rgba(61, 12, 17, 0.85) 100% /* 深红色内敛 */
  );
}

.rank-img {
  width: 48rpx;
  height: 48rpx;
  /* margin-right: 24rpx; */
}

.rank-txt {
  text-align: center;
  font-size: 26rpx;
  color: #ece8e1;
  font-weight: bold;
  /* letter-spacing: 2rpx; */
  /* text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5); */
  margin-bottom: 10rpx;
}

/* 自定义滚动条样式 */
::-webkit-scrollbar {
  width: 4rpx;
  color: transparent;
}
::-webkit-scrollbar-thumb {
  background: #383e44;
  border-radius: 4rpx;
}
