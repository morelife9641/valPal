/* 基础弹窗布局 (与 Pos 组件完全一致) */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 25, 35, 0.85);
  backdrop-filter: blur(8px);
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}
.popup-mask.show {
  visibility: visible;
  opacity: 1;
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #1f2326;
  border-top: 6rpx solid #ff4655; /* 品牌色点缀 */
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  /* padding-bottom: env(safe-area-inset-bottom); */
}
.show .popup-content {
  transform: translateY(0);
}

.p-header {
  padding: 24rpx 30rpx;
  background: #0f1923;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.p-title {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.p-close {
  color: #8b9196;
  font-size: 32rpx;
  padding: 10rpx;
}

/* 🚩 阵营平铺容器 */
.side-container {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.side-btn {
  flex: 1;
  height: 180rpx; /* 稍微增加高度，给渐变留出空间 */
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative; /* 为伪元素定位 */
  overflow: hidden; /* 裁剪超出边界的渐变 */
  transition: all 0.3s ease;
}

/* 🚩 核心：创建从下往上的颜色喷雾 */
.side-btn::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

/* 进攻方（红）喷雾 */
.side-btn.atk.active::after {
  opacity: 1;
  background: linear-gradient(
    0deg,
    rgba(255, 70, 85, 0.25) 0%,
    rgba(255, 70, 85, 0.08) 40%,
    transparent 100%
  );
}

/* 防守方（蓝）喷雾 */
.side-btn.def.active::after {
  opacity: 1;
  background: linear-gradient(
    0deg,
    rgba(0, 238, 255, 0.2) 0%,
    rgba(0, 238, 255, 0.06) 40%,
    transparent 100%
  );
}

/* 🚩 选中的边框和发光 */
.side-btn.active.atk {
  border-color: rgba(255, 70, 85, 0.5);
}
.side-btn.active.def {
  border-color: rgba(0, 238, 255, 0.4);
}

/* 🚩 内容层级调整 */
.side-icon,
.side-label {
  position: relative;
  z-index: 5; /* 确保图标在渐变之上 */
  transition: all 0.3s ease;
}

.side-btn.active .side-icon {
  opacity: 1;
  filter: grayscale(0);
}

/* 进攻方文字 */
.side-btn.active.atk .side-label {
  color: #ff4655;
  text-shadow: 0 0 10rpx rgba(255, 70, 85, 0.3);
}
/* 防守方文字 */
.side-btn.active.def .side-label {
  color: #00eeff;
  text-shadow: 0 0 10rpx rgba(0, 238, 255, 0.3);
}

.side-label {
  font-size: 24rpx;
  font-weight: 900;
  margin-top: 16rpx;
  color: #8b9196;
}
