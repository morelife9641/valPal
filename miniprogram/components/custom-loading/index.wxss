/* 全屏居中容器 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.loading-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.6);
}

/* --- Waterfall 动画开始 --- */
@keyframes waterfall {
  0% {
    opacity: 0;
    transform: translateY(-250%);
  }
  40%,
  60% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(250%);
  }
}

.waterfall {
  position: relative;
  width: 100rpx; /* 给容器一个宽度防止偏移 */
  height: 100rpx;
}

.waterfall view {
  animation: waterfall 1.5s infinite;
  background-color: var(--primary);
  height: 40rpx;
  width: 40rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  margin-top: -20rpx;
  opacity: 0;
}

/* 每个方块的延迟和左右位置 */
.waterfall view:nth-of-type(1) {
  animation-delay: 0.25s;
  margin-left: -20rpx;
}
.waterfall view:nth-of-type(2) {
  animation-delay: 0.5s;
  margin-left: 30rpx;
}
.waterfall view:nth-of-type(3) {
  animation-delay: 0.75s;
  margin-left: -70rpx;
}
.waterfall view:nth-of-type(4) {
  animation-delay: 1s;
  margin-left: 80rpx;
}
.waterfall view:nth-of-type(5) {
  animation-delay: 1.25s;
  margin-left: -120rpx;
}

.waterfall view:nth-of-type(0),
.waterfall view:nth-of-type(2),
.waterfall view:nth-of-type(4) {
  background-color: #ff4655;
  box-shadow: 0 0 10rpx rgba(255, 70, 85, 0.3); /* 红光微晕 */
}

.waterfall view:nth-of-type(1),
.waterfall view:nth-of-type(3) {
  background-color: #1e1e1e;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.5);
}
