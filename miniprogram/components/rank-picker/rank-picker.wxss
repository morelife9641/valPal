/* 遮罩层：毛玻璃效果 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 25, 35, 0.85); /* 瓦罗兰特深蓝底色 */
  backdrop-filter: blur(4px);
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}
.popup-mask.show {
  visibility: visible;
  opacity: 1;
}

/* 弹出容器：占屏幕 40% */
.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 40vh; /* 严格限制 40% 屏幕高度 */
  background: #1f2326;
  border-top: 6rpx solid #ff4655;
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  display: flex;
  flex-direction: column;
}
.show .popup-content {
  transform: translateY(0);
}

/* 头部设计 */
.p-header {
  padding: 14rpx 30rpx;
  background: #0f1923;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.p-title {
  color: #ece8e1;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.p-close {
  color: #8b9196;
  font-size: 32rpx;
  padding: 10rpx;
}

/* 滚动区域 */
.rank-scroll {
  flex: 1;
  overflow: hidden;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.02);
  transition: background 0.2s;
}

/* 选中态：瓦罗兰特红 */
.rank-item.active {
  background: rgba(255, 70, 85, 0.15);
  position: relative;
}
.rank-item.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #ff4655;
}

.rank-img {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
}

.rank-txt {
  color: #ece8e1;
  font-size: 26rpx;
  font-weight: 500;
}

/* 自定义滚动条样式 */
::-webkit-scrollbar {
  width: 4rpx;
  color: transparent;
}
::-webkit-scrollbar-thumb {
  background: #383e44;
  border-radius: 4rpx;
}
