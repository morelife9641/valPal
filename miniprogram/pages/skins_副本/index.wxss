/* 容器背景 */
.skin-container {
  background-color: #0f1214; /* 职业电竞风格的深色背景 */
  min-height: 100vh;
  /* padding: 20rpx; */
}

.filter-container {
  background-color: #0f1214;
  padding: 20rpx 20rpx 10rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

/* 搜索框 */
.search-section {
  margin-bottom: 20rpx;
}

.search-bar {
  background: #1e2125;
  height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid #2d3138;
}

.search-bar input {
  flex: 1;
  margin-left: 15rpx;
  color: #fff;
  font-size: 28rpx;
}

.search-placeholder {
  color: #5d6063;
}

/* 滚动视图容器 */
.filter-scroll-view {
  width: 100%;
  white-space: nowrap;
  margin-top: 15rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
}

.filter-flex-container {
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  gap: 16rpx; /* 胶囊之间的间距 */
}

/* 胶囊基础样式 */
.capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.08); /* 半透明背景 */
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 40rpx; /* 彻底圆角化 */
  transition: all 0.2s ease;
  min-width: 120rpx;
}

.capsule text {
  color: #adadad;
  font-size: 24rpx;
  font-weight: 500;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 选中后的高亮状态 */
.capsule.active {
  background: rgba(255, 70, 85, 0.15);
  border-color: #ff4655;
}

.capsule.active text {
  color: #ff4655;
}

/* 极简小箭头 */
.mini-arrow {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 8rpx solid #666;
  margin-left: 10rpx;
  margin-top: 4rpx;
}

.capsule.active .mini-arrow {
  border-top-color: #ff4655;
}
/* 筛选器行 */
.selector-section {
  display: flex;
  justify-content: space-between;
  gap: 15rpx;
  box-sizing: border-box;
}

.select-item {
  width: 220rpx; /* 三等分左右 */
  height: 64rpx;
  background: #1e2125;
  border: 1rpx solid #2d3138;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.select-item text {
  color: #ccc;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 150rpx;
}

/* 小箭头图标 */
.arrow-down {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #5d6063;
  margin-left: 10rpx;
}

/* 激活状态（可选） */
.select-active {
  border-color: #ff4655;
  color: #fff;
}

/* 父容器：开启 flex 并允许换行 */
.skin-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx; /* 整个页面的左右内边距 */
  justify-content: space-between; /* 让两个卡片分居左右 */
  background-color: #0f1114; /* 瓦罗兰特深色底色 */
}

/* 子卡片：自适应宽度 */
.skin-card {
  width: calc(50% - 12rpx); /* 减去间距的一半，确保一行两个 */
  margin-bottom: 24rpx;
  background: #1c2128;
  border-radius: 8rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* 图片区域：高度设为定值或按比例 */
.img-box {
  position: relative;
  width: 100%;
  height: 200rpx; /* 固定高度确保整齐 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.rarity-icon {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  z-index: 10;
}

.skin-img {
  width: 90%;
  height: 80%;
}

.info-box {
  padding: 16rpx;
  flex: 1; /* 撑满剩余空间 */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.skin-name {
  color: #ece8e1;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  /* 超过一行显示省略号 */
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-val {
  color: #00ffcc;
  font-size: 22rpx;
  font-family: "DIN Alternate", sans-serif;
}

.score {
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.score-num {
  color: #ffb800;
}
.score-unit {
  color: #999;
  margin-left: 2rpx;
}

.load-more {
  text-align: center;
  color: #555;
  font-size: 24rpx;
  padding: 40rpx 0;
}
