.map-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  height: 100vh;
  padding: 20px 10px 140px 10px;
}
.map-card {
  position: relative;
  height: 240rpx;
  border-radius: 8rpx;
  overflow: hidden;
  border: 1rpx solid #333;
}
.map-splash {
  width: 100%;
  height: 100%;
}
.map-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
  padding: 20rpx;
}
.map-name {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  display: block;
}
.map-coord {
  color: #888;
  font-size: 20rpx;
}
