page {
  background: #0f1923;
  overflow: hidden;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.tactical-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  color: #ece8e1;
  overflow: hidden;
}

/* --- 1. 情报资讯层 (Intel Section) --- */
.intel-section {
  padding: 10rpx 0rpx;
  background: linear-gradient(to bottom, rgba(255, 70, 85, 0.08), transparent);
  padding-bottom: 8rpx;
  padding-top: 0;
}

.intel-swiper {
  height: 320rpx;
}

.intel-card {
  width: 100%;
  height: 100%;
  position: relative;
}

.intel-img {
  width: 100%;
  height: 100%;
  filter: brightness(0.7);
}

.intel-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 25rpx;
  background: linear-gradient(to top, #0f1923 0%, transparent 100%);
}

.intel-tag-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.intel-tag {
  font-size: 18rpx;
  background: #ff4655;
  color: #fff;
  padding: 2rpx 14rpx;
  font-weight: 900;
  margin-right: 15rpx;
}

.intel-date {
  font-size: 18rpx;
  color: rgba(139, 145, 150, 0.8);
  font-family: monospace;
}

.intel-title {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

.quick-nav-bar {
  display: flex;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  padding: 8rpx 10rpx;

  background: linear-gradient(
    145deg,
    #1a0507 0%,
    /* 接近黑的极深红 */ #3d0c11 50%,
    /* 中间稍微透出的血红色 */ #1a0507 100% /* 回归极深红 */
  );
  background: linear-gradient(to bottom, #171e26, #0f1923);
  background: #0f1923;
}
/* 单个入口卡片 */
.nav-item {
  position: relative;
  height: 80rpx; /* 稍微加高一点，更有体感 */
  width: 25%; /* 留出一点 gap 空间 */
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 22rpx; /* 稍微缩小字号，配合字间距更有高级感 */
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #ece8e1; /* 瓦罗兰特招牌米白色 */
  background: rgba(255, 255, 255, 0.03); /* 极淡的透明底 */
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);

  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(255, 255, 255, 0.02) 25%,
    rgba(255, 255, 255, 0.01) 100%
  );

  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.1) 0%,
    rgba(255, 255, 255, 0.03) 30%,
    transparent 100%
  );
  /* 🚩 边框也做成半透明，增加精致感 */
  border: 1rpx solid rgba(255, 255, 255, 0.1);

  /* 🚩 增加一个淡淡的内发光，让按钮看起来有厚度，而非单纯的色块 */
  /* box-shadow: inset 0 0 10rpx rgba(255, 255, 255, 0.02); */
  box-shadow: inset 0 -20rpx 20rpx -20rpx rgba(255, 70, 85, 0.1);
  /* 🚩 核心：硬核切角（瓦服UI标志） */
  /* clip-path: polygon(0 0, 100% 0, 100% 70%, 88% 100%, 0 100%); */
}

/* 🚩 鼠标按下或选中状态 */
.nav-item:active {
  background: rgba(255, 70, 85, 0.1); /* 微弱的红晕 */
  border-color: rgba(255, 70, 85, 0.5);
}

/* 🚩 底部装饰细节：增加一个极细的辅助线 */
.nav-item::after {
  content: "";
  position: absolute;
  bottom: 4rpx;
  right: 12rpx;
  width: 8rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 激活状态交互 */
.nav-item:active {
  background-color: #2a2e33;
  transform: scale(0.97);
}

/* 内部文字样式 */
.nav-info {
  position: relative;
  z-index: 2;
}

.nav-en {
  font-size: 18rpx;
  color: #ff4655;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin-bottom: 6rpx;
  display: block;
  opacity: 0.9;
}

.nav-cn {
  font-size: 30rpx;
  color: #ece8e1;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 🚩 侧边微弱编号（辅助装饰） */
.nav-deco {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.02);
  font-style: italic;
  z-index: 1;
}

/* --- 3. 地图选择区 (Header Section) --- */

/* 迷你赛季标签 */
.season-badge {
  margin-left: 12rpx;
  background: #ff4655;
  padding: 2rpx 10rpx; /* 极小的内边距 */
  /* 简单的斜切平行四边形，视觉更稳 */
  /* transform: skewX(-15deg); */
  display: flex;
  align-items: center;
  justify-content: center;
}

.season-text {
  font-size: 14rpx; /* 进一步缩小字号 */
  color: #ffffff;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1;
}

/* 方案：底部一个亮色小滑块，增加动感 */
.active-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 40%;
  height: 6rpx;
  background: #ff4655;
  z-index: 6;
  box-shadow: 0 0 10rpx #ff4655;
}
/* --- 第二段：英雄样式 --- */
/* --- 英雄区域容器 --- */
.hero-section {
  background: #0f1923; /* 保持与背景一致 */
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* --- 职业 Tabs 统一风格 --- */
.role-tabs {
  display: flex;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
  gap: 12rpx;
}

.role-tab {
  font-size: 20rpx;
  padding: 8rpx 24rpx;
  background: #161d24;
  color: #8b978f;
  /* 斜切平行四边形 */
  /* clip-path: polygon(15% 0, 100% 0, 85% 100%, 0 100%); */
  transition: all 0.3s ease;
}

.role-tab.active {
  background: #ff4655;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.5);
}

/* --- 1. 列表区域基础容器 --- */
.list-section {
  /* border-top: 1rpx solid rgba(255, 255, 255, 0.05); */
  border-top: 1rpx solid rgba(255, 70, 85, 0.3);
  margin-top: 10rpx;
  width: 100%;
  min-height: 0;
  flex: 1; /* 核心：告诉它占满剩余所有高度 */
  display: flex;
  background: #171e26; /* 稍微提亮一点背景，与大底区分 */
  flex-direction: column;
  overflow: hidden; /* 防止外层溢出 */
}

.tabbar-placeholder {
  /* 必须确保高度足够 */
  height: calc(220rpx + env(safe-area-inset-bottom));
  width: 100%;
  flex-shrink: 0; /* 防止被压缩 */
}

.stats-table {
  width: 100%;
  flex: 1; /* 🚩 必须填满 list-section */
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: rgba(15, 25, 35, 0.3);
}

.horizontal-scroll {
  flex: 1; /* [cite: 38] */
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
}

/* 4. 重点：垂直滚动的 tbody */
.table-tbody {
  /* 假设你上面的标题 + Swiper 总共占了 500rpx */
  flex: 1; /* 🚩 让它自动占据剩余的所有像素空间 */
  height: 0; /* 🚩 绝招：高度设为0，强制让 flex-grow 决定其真实高度 */
  width: 100%;
}

.table-content-wrap {
  flex: 1; /* 🚩 必须填满，否则内部滚动失效 */
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: max-content;
  min-width: 100%;
}

.tabbar-bottom-spacer {
  /* 高度 = 你的自定义 TabBar 高度 + 安全区距离 [cite: 37] */
  height: calc(100rpx + env(safe-area-inset-bottom));
  width: 100%;
  flex-shrink: 0;
  pointer-events: none;
}

/* --- 2. 行布局 (thead & tr) --- */
.table-thead,
.table-tr {
  display: flex;
  align-items: center;
  padding: 0 10rpx;
}

.table-thead {
  height: 80rpx;
  background: #1f2326;
  /* border-top: 1rpx solid rgba(255, 70, 85, 0.3); */
  position: sticky; /* 粘性表头（视基础库支持情况） */
  top: 0;
  z-index: 10;
}

.table-tr {
  height: 100rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* 斑马纹 */
.table-tr:nth-child(even) {
  background: rgba(255, 255, 255, 0.02);
}

/* 点击态 */
.table-tr:active {
  background: rgba(255, 70, 85, 0.05);
}

/* 排名列：包含表头的 Rank Picker */
.th.rank,
.td.rank {
  width: 70rpx;
  justify-content: center;
}

/* 特工列：图标+名字 */
.th.agent,
.td.agent {
  display: flex;
  align-items: center;
  flex: 3; /* 适当增加特工列的比例，因为它包含头像和名字 */
  min-width: 0; /* 🚩 关键：允许子元素缩放，防止挤爆 */
  padding-left: 10rpx;
}

/* 胜率列 */
.th.win,
.td.win {
  width: 120rpx;
  justify-content: center;
}

/* KD列 */
.th.kd,
.td.kd {
  width: 100rpx;
  justify-content: center;
}

/* KDA列：三个数字，稍微宽一点 */
.th.kda,
.td.kda {
  width: 180rpx;
  justify-content: center;
}

/* ACS 评分 */
.th.acs,
.td.acs {
  width: 120rpx;
  justify-content: center;
}

/* 登场率 */
.th.pick,
.td.pick {
  width: 120rpx;
  justify-content: center;
}

/* 对局数 */
.th.matches,
.td.matches {
  width: 140rpx;
  justify-content: center;
  /* color: #ece8e1; */
}

/* 策略按钮基础样式 */
.strategy-btn {
  position: relative;
  width: 100rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  /* 瓦罗兰特切角风格 */
  /* clip-path: polygon(0 0, 100% 0, 100% 75%, 85% 100%, 0 100%); */
}

.btn-text {
  color: #ece8e1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  z-index: 2;
}

/* 按钮内部的红色装饰线（默认隐藏或极淡） */
.btn-deco {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 4rpx;
  height: 0;
  background: #ff4655;
  transition: all 0.2s ease;
}

/* 🚩 悬浮/点击效果 */
.strategy-btn:active {
  background: rgba(255, 70, 85, 0.2);
  border-color: #ff4655;
  transform: scale(0.95);
}

.strategy-btn:active .btn-text {
  color: #ffffff;
}

.strategy-btn:active .btn-deco {
  height: 100%; /* 点击时侧边红条升起 */
}
/* --- 4. 文本样式微调 --- */

.th,
.td {
  flex-shrink: 0;
  display: flex;
  align-items: center; /* 垂直居中 */
  box-sizing: border-box;
}
.th {
  justify-content: center; /* 所有表头文字强制水平居中 */
  color: #8b9196;
  font-size: 20rpx;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.td {
  color: #ece8e1;
  font-size: 24rpx;
}

/* 示例：确保新字段宽度适中 */
.th.nm-win,
.td.nm-win {
  width: 140rpx;
  justify-content: center;
}

.th.matches,
.td.matches {
  width: 140rpx;
  text-align: center;
}

/* 排名数字 */
.rank-num {
  color: #8b9196;
  font-weight: bold;
}

/* 特工头像与职业图标 */
.agent-avatar-box {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.td-role-icon {
  width: 32rpx;
  height: 32rpx;
  /* opacity: 0.6; */
}

.td-agent-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 4rpx;
  background: #0f1923;
  border-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.td-agent-name {
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 颜色标记 */
.text-green {
  color: #00ffbb;
}
.text-red {
  color: #ff4655;
}

/* --- 5. 表头 Rank Picker 样式 --- */
.rank-picker-trigger {
  background: rgba(255, 70, 85, 0.15);
  border: 1rpx solid rgba(255, 70, 85, 0.4);
  padding: 6rpx 12rpx;
  border-radius: 2rpx;
  display: flex;
  align-items: center;
}

.rank-picker-trigger text {
  color: #ff4655;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

/* --- 6. 空状态与加载 --- */
.empty-container {
  padding: 100rpx 0;
  text-align: center;
}

.empty-title {
  color: #ece8e1;
  font-size: 28rpx;
  display: block;
  margin-bottom: 10rpx;
}

.empty-desc {
  color: #8b9196;
  font-size: 22rpx;
}

/* --- 7. 缺省图与滚动条隐藏 --- */
.empty-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #101823;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 0.5s ease-out;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.2; /* 保持低调的瓦罗兰特风格 */
  filter: grayscale(100%);
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ece8e1;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #768079;
}

/* 入场动画，让切换更丝滑 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 隐藏自带的滚动条，保持界面简洁 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.tabbar-placeholder {
  /* 100rpx(TabBar高) + 20px(padding上下) + 安全区 */
  height: 100rpx;
  width: 100%;
  pointer-events: none; /* 确保不响应点击 */
  /* border: none; */
}

/* 前三名通用样式 */
.top-three {
  position: relative;
  /* 背景使用深蓝色到透明的渐变，防止干扰文字阅读 */
  background: linear-gradient(
    90deg,
    rgba(255, 70, 85, 0.08) 0%,
    rgba(255, 70, 85, 0.02) 50%,
    transparent 100%
  ) !important;
}

/* 前三名左侧共用的发光切边 */
.top-three::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 4rpx;
  z-index: 2;
}

/* 第一名：金/红 质感 */
.top-1 {
  background: linear-gradient(
    90deg,
    rgba(255, 70, 85, 0.15) 0%,
    rgba(255, 70, 85, 0.05) 60%,
    transparent 100%
  ) !important;
}
.top-1::before {
  background: #ff4655; /* 瓦罗兰特红 */
  box-shadow: 0 0 12rpx rgba(255, 70, 85, 0.8);
}
.top-1 .rank-num {
  color: #ff4655 !important;
  /* font-size: 32rpx; */
}

/* 第二名：银色/白光 质感 */
.top-2 {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(255, 255, 255, 0.02) 60%,
    transparent 100%
  ) !important;
}
.top-2::before {
  background: #ece8e1;
  box-shadow: 0 0 10rpx rgba(236, 232, 225, 0.5);
}

/* 第三名：深铜/暗光 质感 */
.top-3 {
  background: linear-gradient(
    90deg,
    rgba(139, 145, 150, 0.1) 0%,
    transparent 100%
  ) !important;
}
.top-3::before {
  background: #8b9196;
}

/* 强化前三名的名字显示 */
.top-three .td-agent-name {
  color: #ffffff;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.2);
}

/* 中区域  战术区域*/
.tactical-hub {
  background: #0f1923;
  padding: 14rpx 0;
  /* margin-top: 10rpx; */
}

/* 1. 地图选择器 */
.map-nav {
  padding: 0 12rpx;
  /* margin-bottom: 4rpx; */
}
.map-scroll {
  display: flex;
  height: 80rpx;
}
.map-cell {
  flex: 1;
  /* width: 140rpx; */
  height: 70rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
  background: #1f2326;
  position: relative;
  border: 1rpx solid #383e44;
}
.map-thumb {
  width: 100%;
  height: 100%;
  opacity: 0.5;
  transition: 0.3s;
}
.map-cell.active {
  border-color: #ff4655;
}
.map-cell.active .map-thumb {
  opacity: 1;
}
.map-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #ff4655;
  transform: scaleX(0);
  transition: 0.3s;
}
.map-cell.active .map-line {
  transform: scaleX(1);
}

/* 2. 信息面板 */
.hub-panel {
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin: 4rpx 0;
  margin-bottom: 12rpx;
}
.panel-tag {
  font-size: 18rpx;
  color: #ff4655;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.map-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #ece8e1;
  text-transform: uppercase;
}
.map-label {
  font-size: 22rpx;
  color: #8b9196;
  margin-left: 10rpx;
}
.panel-action {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #ece8e1;
  padding-bottom: 6rpx;
}
.action-dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff4655;
  margin-left: 10rpx;
  transform: rotate(45deg);
}

/* 3. 卡片展示区 */
.hub-content {
  width: 100%;
}
.card-group {
  display: flex;
  padding: 0 30rpx 20rpx;
}
.point-card {
  flex: 1;
  /* width: 440rpx; */
  background: #1f2326;
  margin-right: 20rpx;
  border: 1rpx solid #383e44;
}
.point-image-box {
  width: 100%;
  height: 240rpx;
  position: relative;
}
.point-img {
  width: 100%;
  height: 100%;
}
.point-hero {
  position: absolute;
  top: 0;
  right: 0;
  background: #ff4655;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  font-weight: bold;
}
.point-details {
  padding: 20rpx;
}
.point-dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff4655;
  margin-right: 12rpx;
}
.point-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.point-name {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: bold;
}
.point-desc {
  font-size: 20rpx;
  color: #8b9196;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
}

/* 更多卡片 */
.point-more {
  width: 120rpx;
  height: 380rpx; /* 匹配 point-card 总高 */
  background: rgba(255, 70, 85, 0.05);
  border: 1rpx dashed #383e44;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ff4655;
}
.more-plus {
  font-size: 40rpx;
  margin-top: 10rpx;
}

.empty-status {
  font-size: 20rpx;
  color: #383e44;
  letter-spacing: 4rpx;
}

/* 攻防行样式 */
.tactical-row {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(56, 62, 68, 0.5);
}

.side-label {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  writing-mode: vertical-lr; /* 文字竖排 */
  text-align: center;
  letter-spacing: 4rpx;
}

/* 进攻：青色系 */
.side-label.def {
  background: rgba(0, 184, 161, 0.1);
  color: #00b8a1;
  /* border-right: 4rpx solid #00b8a1; */
}

/* 防守：橙色/红色系 */
.side-label.atk {
  background: rgba(255, 70, 85, 0.1);
  color: #ff4655;
  /* border-right: 4rpx solid #ff4655; */
}

.inner-scroll {
  flex: 1;
  height: 100%;
  white-space: nowrap;
}

.mini-card-group {
  display: flex;
  padding: 10rpx 20rpx;
}

/* minicard */
/* --- 基础卡片样式 --- */
.mini-card {
  position: relative;
  width: 160rpx;
  height: 156rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #1f2326;
  border: 1rpx solid rgba(236, 232, 225, 0.1); /* 极细边框 */
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden; /* 必须，裁剪溢出的多边形 */
}

/* --- 核心：多边形装饰放大 (作为背景底纹) --- */
.card-accent {
  position: absolute;
  top: -20rpx;
  right: -40rpx;
  width: 160rpx; /* 放大 */
  height: 160rpx;
  transform: rotate(15deg); /* 改为小角度，更有工业感 */
  opacity: 0.1; /* 保持低调 */
  pointer-events: none;
  z-index: 1;
}

/* --- 方案：全背景渐变切换 --- */

/* A区 - 琥珀金 */
.type-a {
  /* 明显的左上角渐变底色 */
  /* background: linear-gradient(135deg, rgba(255, 184, 0, 0.15) 0%, #1f2326 60%); */
  /* border-left: 4rpx solid #ffb800; 保留细长色条增强辨识度 */
}
.type-a .site-label {
  color: #ffb800;
}
.type-a .card-accent {
  background: #ffb800;
}

/* B区 - 电光紫 */
.type-b {
  /* background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, #1f2326 60%); */
  /* border-left: 4rpx solid #8b5cf6; */
}
.type-b .site-label {
  color: #8b5cf6;
}
.type-b .card-accent {
  background: #8b5cf6;
}

/* 其他 - 工业白 */
.type-other {
  /* background: linear-gradient(135deg, rgba(236, 232, 225, 0.1) 0%, #1f2326 60%); */
  /* border-left: 4rpx solid #ece8e1; */
}
.type-other .site-label {
  color: #ece8e1;
}
.type-other .card-accent {
  background: #ece8e1;
}

/* --- 内部内容细节 --- */

.mini-header {
  position: relative;
  z-index: 2; /* 确保在多边形之上 */
}

.site-label {
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.mini-main {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
}

.mini-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* 在标题前伪造一个编号感 */

.mini-title {
  font-size: 22rpx;
  color: #ece8e1;
  font-weight: bold;
  line-height: 1.2;
  /* 强制两行，不够两行也占位，保持视觉对齐 */
  min-height: 38rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-transform: uppercase; /* 英文标题时非常硬核 */
}

/* 空状态 */
.row-empty-hint {
  width: 100%;
  padding: 40rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: rgba(236, 232, 225, 0.2);
  letter-spacing: 4rpx;
}

.empty-frame {
  border: 1rpx dashed #383e44;
  padding: 40rpx 60rpx;
  text-align: center;
  position: relative;
}

.empty-frame text {
  font-size: 18rpx;
  color: #383e44;
  letter-spacing: 4rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #8b9196;
  margin-top: 20rpx;
  display: block;
  text-align: center;
}

.fixed-height {
  height: 300rpx; /* 假设总高度 */
  background: #0f1923;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 强制切除溢出部分 */
  box-sizing: border-box;
}

.tactical-row {
  height: 50%; /* 完美平分 */
  display: flex;
  align-items: stretch; /* 让 label 和 scroll 撑满高度 */
  position: relative;
  box-sizing: border-box;
}

/* 分割线 */
.row-divider {
  height: 1rpx;
  background: rgba(56, 62, 68, 0.5);
  margin: 0 30rpx;
}

.side-label {
  width: 50rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  writing-mode: vertical-lr;
  letter-spacing: 2rpx;
}

.side-label.def {
  background: rgba(0, 184, 161, 0.1);
  color: #00b8a1;
  /* border-right: 2rpx solid #00b8a1; */
}

.side-label.atk {
  background: rgba(255, 70, 85, 0.1);
  color: #ff4655;
  /* border-right: 2rpx solid #ff4655; */
}

.inner-scroll {
  flex: 1;
  height: 100%; /* 继承父级 50% 的高度 */
  overflow: hidden;
}

.mini-card-group {
  display: flex;
  align-items: center; /* 垂直居中卡片 */
  height: 100%;
  padding: 0 20rpx;
}

.mini-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(to top, #000, transparent);
}

.mini-name {
  color: #ece8e1;
  font-size: 22rpx;
  font-weight: bold;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-hero {
  color: #8b9196;
  font-size: 16rpx;
}

/* 占位提示 */
.row-empty-hint {
  color: #383e44;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

/* 空状态对齐 */
.hub-empty {
  position: relative;
  height: 100%;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f1923; /* 容器底色 */
  overflow: hidden;
}

.empty-bg-map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  filter: grayscale(100%) brightness(0.25) contrast(1.2);
  /* 关键点 1：初始透明度设为 0，防止加载瞬间的原图闪烁 */
  opacity: 0;
  transition: opacity 0.4s ease-in-out;
}

/* 关键点 2：当图片加载完成后，由 JS 控制增加这个类 */
.empty-bg-map.loaded {
  opacity: 0.5;
}

.empty-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, transparent 10%, #0f1923 90%);
  z-index: 2;
  pointer-events: none;
}

/* 基础行样式重构 */

/* 内部滚动区域微调 */
.inner-scroll {
  flex: 1;
  height: 100%;
  z-index: 1;
}

.tactical-ctrl-bar {
  display: flex;
  align-items: center;
  /* justify-content: space-between; */
  height: 40rpx; /* 稍微加高一点，更有分量 */
  /* background: #1f2326; */
  width: 360rpx;
  /* margin: 20rpx 30rpx 20rpx; */
  /* margin: 30rpx 0; */
  padding: 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  /* 🚩 瓦式切角：两头尖中间平 */
  /* clip-path: polygon(3% 0, 97% 0, 100% 25%, 100% 100%, 0 100%, 0 25%); */
}

.ctrl-btn {
  flex: 1;
  width: 25%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  position: relative;
  transition: all 0.1s ease;
}

/* 点击反馈：变亮并轻微缩放 */
.ctrl-btn:active {
  background: rgba(255, 70, 85, 0.05);
  transform: scale(0.98);
}

.ctrl-info {
  display: flex;
  flex-direction: column;
}

.ctrl-label {
  font-size: 16rpx;
  color: rgba(236, 232, 225, 0.4);
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.ctrl-value {
  font-size: 22rpx;
  color: #ece8e1;
  font-weight: 900;
  letter-spacing: 1rpx;
}

/* 🚩 装饰分割线 */
.ctrl-divider {
  width: 1rpx;
  height: 50rpx;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(255, 70, 85, 0.4),
    transparent
  );
}

/* 🚩 按钮右侧的小图标/点缀 */
.icon-rank-deco,
.icon-map-deco {
  width: 12rpx;
  height: 12rpx;
  border-right: 4rpx solid #ff4655;
  border-bottom: 4rpx solid #ff4655;
  transform: rotate(45deg);
  opacity: 0.8;
}

/* 在按钮底部加一个微弱的红色指示条，呼应你的 Tabbar */
.ctrl-btn::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30rpx;
  right: 30rpx;
  height: 2rpx;
  background: rgba(255, 70, 85, 0.2);
}

.filter-tag-row {
  display: flex;
  justify-content: flex-start; /* 改为靠左，更有档案列表感 */
  gap: 16rpx;
  background: #171e26;
  font-weight: bold;
  padding: 0 20rpx;
  margin: 14rpx 0 14rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  height: 48rpx; /* 进一步压缩高度 */
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.03); /* 极淡的灰，几乎透明 */
  border: 1rpx solid rgba(255, 255, 255, 0.1); /* 低调的深灰边框 */
  position: relative;
  /* 🚩 极简切角：只切左上角一个微小的口 */
  /* clip-path: polygon(8rpx 0, 100% 0, 100% 100%, 0 100%, 0 8rpx); */
  transition: all 0.2s ease;
}

/* 激活状态：当用户选了特定段位/地图时 */
.filter-tag.active {
  border: 1rpx solid rgba(255, 70, 85, 0.3);
  background: rgba(255, 70, 85, 0.05);
}

.tag-text {
  font-size: 20rpx; /* 缩小字号 */
  color: rgba(236, 232, 225, 0.5); /* 默认半透明米色 */
  font-weight: bold;
  letter-spacing: 1rpx;
}

.filter-tag.active .tag-text {
  color: #ece8e1; /* 激活时文字变亮 */
}

/* 🚩 低调的箭头：不再用大三角形，用简单的 L 型勾边 */
.tag-arrow {
  width: 8rpx;
  height: 8rpx;
  border-right: 2rpx solid rgba(255, 255, 255, 0.3);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.3);
  transform: rotate(45deg);
  margin-left: 10rpx;
  margin-bottom: 4rpx;
}

.filter-tag.active .tag-arrow {
  border-color: #ff4655; /* 激活时箭头变红 */
}

/* 🚩 装饰细线：移到左侧，变成一个垂直的小刻度 */
.tag-deco-line {
  position: absolute;
  left: 0;
  top: 20%;
  /* width: 4rpx; */
  height: 60%;
  background: rgba(255, 255, 255, 0.1);
}

.filter-tag.active .tag-deco-line {
  background: #ff4655; /* 激活时侧边红线亮起 */
  box-shadow: 0 0 8rpx #ff4655;
}

/* 点击反馈 */
.filter-tag:active {
  background: rgba(255, 255, 255, 0.08);
}

.tag-rank-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  /* 稍微加一点滤镜，让图标在深色背景下更有“发光”感 */
  filter: drop-shadow(0 0 5rpx rgba(255, 255, 255, 0.2));
}

/* 重制按钮 */
.reset-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.03); /* 极淡的灰，几乎透明 */
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: center;
  align-items: center;
  align-self: center;
  /* float: right; */
  margin-left: auto;
  transition: all 0.2s;
  flex-shrink: 0; /* 禁止被压缩 */
}

.reset-icon {
  color: #ff4655;
  font-size: 36rpx;
  font-weight: bold;
}

/* 激活反馈：点击时变红 */
.reset-btn:active {
  background: rgba(255, 70, 85, 0.2);
  border-color: #ff4655;
}

.reset-btn:active .reset-icon {
  color: #ff4655;
  transform: rotate(-180deg);
  transition: transform 0.3s ease;
}
