page {
  background: #0f1923;
  overflow: hidden;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.tactical-container {
  display: flex;
  flex-direction: column;
  /* height: 100vh; */
  color: #ece8e1;
  padding-bottom: 200rpx;
}

/* --- 1. 情报资讯层 (Intel Section) --- */
.intel-section {
  padding: 20rpx 12rpx;
  background: linear-gradient(to bottom, rgba(255, 70, 85, 0.08), transparent);
}

.intel-swiper {
  height: 240rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  /* 瓦式切角：右下角切掉 */
  clip-path: polygon(0 0, 100% 0, 100% 88%, 96% 100%, 0 100%);
}

.intel-card {
  width: 100%;
  height: 100%;
  position: relative;
}

.intel-img {
  width: 100%;
  height: 100%;
  filter: brightness(0.7);
}

.intel-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 25rpx;
  background: linear-gradient(to top, #0f1923 0%, transparent 100%);
}

.intel-tag-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.intel-tag {
  font-size: 18rpx;
  background: #ff4655;
  color: #fff;
  padding: 2rpx 14rpx;
  font-weight: 900;
  margin-right: 15rpx;
}

.intel-date {
  font-size: 18rpx;
  color: rgba(139, 145, 150, 0.8);
  font-family: monospace;
}

.intel-title {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

/* --- 2. 快捷战术工具 (分格按钮版) --- */
.quick-nav-bar {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 10rpx;
  background: #0f1923; /* 底色保持纯净 */
}

.nav-item {
  flex: 1;
  height: 64rpx;
  margin: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;

  /* 核心：用渐变画出左侧的 4rpx 红色竖线，其余部分为深灰黑 */
  /* 逻辑：0-4rpx是红色，4rpx以后是深灰色 */
  background: linear-gradient(
    to right,
    #ff4655 0%,
    #ff4655 6rpx,
    #1f2326 6rpx,
    #1a1e21 100%
  );

  /* 细微的边框，增加金属质感 */
  border: 1rpx solid #383e44;
  /* 必须为 0，保持硬核直角 */
  border-radius: 0;

  transition: all 0.1s;
}

.nav-item text {
  color: #ece8e1;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  /* 稍微向右偏移一点，因为左边有红条 */
  padding-left: 6rpx;
}

/* 活跃/点击状态：变为瓦罗兰特红 */
.nav-item:active {
  background: #ff4655;
  border-color: #ff4655;
  transform: translateY(2rpx); /* 按下的物理感 */
}

.nav-item:active text {
  color: #ffffff;
}

/* 重新调整图标符号在小按钮里的比例 */
.icon-crosshair::after {
  content: "⊹";
  color: #ff4655;
  font-size: 24rpx;
}
.icon-pro::after {
  content: "◈";
  color: #ff4655;
  font-size: 22rpx;
}
.icon-skin::after {
  content: "⬢";
  color: #ff4655;
  font-size: 22rpx;
}
.icon-wiki::after {
  content: "≡";
  color: #ff4655;
  font-size: 24rpx;
}

/* --- 3. 地图选择区 (Header Section) --- */

/* 迷你赛季标签 */
.season-badge {
  margin-left: 12rpx;
  background: #ff4655;
  padding: 2rpx 10rpx; /* 极小的内边距 */
  /* 简单的斜切平行四边形，视觉更稳 */
  /* transform: skewX(-15deg); */
  display: flex;
  align-items: center;
  justify-content: center;
}

.season-text {
  font-size: 14rpx; /* 进一步缩小字号 */
  color: #ffffff;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1;
}

/* 方案：底部一个亮色小滑块，增加动感 */
.active-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 40%;
  height: 6rpx;
  background: #ff4655;
  z-index: 6;
  box-shadow: 0 0 10rpx #ff4655;
}
/* --- 第二段：英雄样式 --- */
/* --- 英雄区域容器 --- */
.hero-section {
  background: #0f1923; /* 保持与背景一致 */
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* --- 职业 Tabs 统一风格 --- */
.role-tabs {
  display: flex;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
  gap: 12rpx;
}

.role-tab {
  font-size: 20rpx;
  padding: 8rpx 24rpx;
  background: #161d24;
  color: #8b978f;
  /* 斜切平行四边形 */
  /* clip-path: polygon(15% 0, 100% 0, 85% 100%, 0 100%); */
  transition: all 0.3s ease;
}

.role-tab.active {
  background: #ff4655;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.5);
}

/* --- 英雄卡片列表 --- */
.hero-scroll {
  height: 180rpx;
  white-space: nowrap;
  padding-left: 20rpx;
}

.hero-box {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 20rpx;
  position: relative;
  padding-top: 10rpx;
}

/* 英雄头像外框 - 改为方块斜切 */
.hero-icon-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  background: #161d24;
  /* clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%); */
  transition: background 0.3s;
}

.hero-icon {
  width: 100%;
  height: 100%;
  opacity: 0.6;
  transition: opacity 0.3s;
}

/* --- 选中状态：不使用 Scale，使用内嵌元素 --- */
.hero-box.active .hero-icon-wrap {
  background: #2d363d;
}

.hero-box.active .hero-icon {
  opacity: 1;
}

/* 红色内边框，绝不抖动 */
.hero-active-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 4rpx solid #ff4655;
  z-index: 2;
  pointer-events: none;
  /* clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%); */
}

.hero-name {
  font-size: 20rpx;
  margin-top: 12rpx;
  color: #8b978f;
  font-weight: bold;
  transition: color 0.3s;
}

.hero-box.active .hero-name {
  color: #fff;
}

/* 底部指示器：一个小横条或红点 */
.hero-active-dot {
  width: 30rpx;
  height: 4rpx;
  background: #ff4655;
  margin-top: 8rpx;
  box-shadow: 0 0 8rpx #ff4655;
}

/* --- 1. 列表区域基础容器 --- */
.list-section {
  width: 100%;
  /* margin-top: 20rpx; */
  /* padding-bottom: 40rpx; */
  flex: 1; /* 核心：告诉它占满剩余所有高度 */
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 防止外层溢出 */
}

.stats-table {
  width: 100%;
  background: rgba(15, 25, 35, 0.3);
}

/* 允许内容水平滚动 */
.horizontal-scroll {
  width: 100%;
  white-space: nowrap;
}

.horizontal-scroll {
  flex: 1; /* 让它填满 list-section */
  display: flex;
  flex-direction: column;
}

/* 4. 重点：垂直滚动的 tbody */
.table-tbody {
  /* 假设你上面的标题 + Swiper 总共占了 500rpx */
  height: calc(100vh - 860rpx - env(safe-area-inset-bottom));
}

.table-content-wrap {
  height: 100%;
  display: flex;
  flex-direction: column;
  /* 核心属性：由内容决定宽度，且最小宽度为100% */
  width: max-content;
  min-width: 100%;
}

/* --- 2. 行布局 (thead & tr) --- */
.table-thead,
.table-tr {
  display: flex;
  align-items: center;
  padding: 0 10rpx;
}

.table-thead {
  height: 80rpx;
  background: #1f2326;
  border-top: 1rpx solid rgba(255, 70, 85, 0.3);
  position: sticky; /* 粘性表头（视基础库支持情况） */
  top: 0;
  z-index: 10;
}

.table-tr {
  height: 100rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* 斑马纹 */
.table-tr:nth-child(even) {
  background: rgba(255, 255, 255, 0.02);
}

/* 点击态 */
.table-tr:active {
  background: rgba(255, 70, 85, 0.05);
}

/* 排名列：包含表头的 Rank Picker */
.th.rank,
.td.rank {
  width: 120rpx;
  justify-content: center;
}

/* 特工列：图标+名字 */
.th.agent,
.td.agent {
  width: 220rpx;
  padding-left: 10rpx;
}
.th.agent {
  padding-left: 0; /* 清除左内边距，确保文字在 280rpx 范围内绝对居中 */
}

/* 胜率列 */
.th.win,
.td.win {
  width: 120rpx;
  justify-content: center;
}

/* KD列 */
.th.kd,
.td.kd {
  width: 100rpx;
  justify-content: center;
}

/* KDA列：三个数字，稍微宽一点 */
.th.kda,
.td.kda {
  width: 180rpx;
  justify-content: center;
}

/* ACS 评分 */
.th.acs,
.td.acs {
  width: 120rpx;
  justify-content: center;
}

/* 登场率 */
.th.pick,
.td.pick {
  width: 120rpx;
  justify-content: center;
}

/* 对局数 */
.th.matches,
.td.matches {
  width: 140rpx;
  justify-content: center;
}

/* --- 4. 文本样式微调 --- */

.th,
.td {
  flex-shrink: 0;
  display: flex;
  align-items: center; /* 垂直居中 */
  box-sizing: border-box;
}
.th {
  justify-content: center; /* 所有表头文字强制水平居中 */
  color: #8b9196;
  font-size: 20rpx;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.td {
  color: #ece8e1;
  font-size: 24rpx;
}

/* 示例：确保新字段宽度适中 */
.th.nm-win,
.td.nm-win {
  width: 140rpx;
  justify-content: center;
}

.th.matches,
.td.matches {
  width: 140rpx;
  text-align: center;
}

/* 排名数字 */
.rank-num {
  color: #8b9196;
  font-weight: bold;
}

/* 特工头像与职业图标 */
.agent-avatar-box {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.td-role-icon {
  width: 32rpx;
  height: 32rpx;
  /* opacity: 0.6; */
}

.td-agent-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 4rpx;
  background: #0f1923;
  border-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.td-agent-name {
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 颜色标记 */
.text-green {
  color: #00ffbb;
}
.text-red {
  color: #ff4655;
}

/* --- 5. 表头 Rank Picker 样式 --- */
.rank-picker-trigger {
  background: rgba(255, 70, 85, 0.15);
  border: 1rpx solid rgba(255, 70, 85, 0.4);
  padding: 6rpx 12rpx;
  border-radius: 2rpx;
  display: flex;
  align-items: center;
}

.rank-picker-trigger text {
  color: #ff4655;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

/* --- 6. 空状态与加载 --- */
.empty-container {
  padding: 100rpx 0;
  text-align: center;
}

.empty-title {
  color: #ece8e1;
  font-size: 28rpx;
  display: block;
  margin-bottom: 10rpx;
}

.empty-desc {
  color: #8b9196;
  font-size: 22rpx;
}

/* --- 7. 缺省图与滚动条隐藏 --- */
.empty-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #101823;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 0.5s ease-out;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.2; /* 保持低调的瓦罗兰特风格 */
  filter: grayscale(100%);
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ece8e1;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #768079;
}

/* 入场动画，让切换更丝滑 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 隐藏自带的滚动条，保持界面简洁 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.tabbar-placeholder {
  /* 100rpx(TabBar高) + 20px(padding上下) + 安全区 */
  height: 100rpx;
  width: 100%;
  pointer-events: none; /* 确保不响应点击 */
  /* border: none; */
}

/* 前三名通用样式 */
.top-three {
  position: relative;
  /* 背景使用深蓝色到透明的渐变，防止干扰文字阅读 */
  background: linear-gradient(
    90deg,
    rgba(255, 70, 85, 0.08) 0%,
    rgba(255, 70, 85, 0.02) 50%,
    transparent 100%
  ) !important;
}

/* 前三名左侧共用的发光切边 */
.top-three::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 4rpx;
  z-index: 2;
}

/* 第一名：金/红 质感 */
.top-1 {
  background: linear-gradient(
    90deg,
    rgba(255, 70, 85, 0.15) 0%,
    rgba(255, 70, 85, 0.05) 60%,
    transparent 100%
  ) !important;
}
.top-1::before {
  background: #ff4655; /* 瓦罗兰特红 */
  box-shadow: 0 0 12rpx rgba(255, 70, 85, 0.8);
}
.top-1 .rank-num {
  color: #ff4655 !important;
  /* font-size: 32rpx; */
}

/* 第二名：银色/白光 质感 */
.top-2 {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(255, 255, 255, 0.02) 60%,
    transparent 100%
  ) !important;
}
.top-2::before {
  background: #ece8e1;
  box-shadow: 0 0 10rpx rgba(236, 232, 225, 0.5);
}

/* 第三名：深铜/暗光 质感 */
.top-3 {
  background: linear-gradient(
    90deg,
    rgba(139, 145, 150, 0.1) 0%,
    transparent 100%
  ) !important;
}
.top-3::before {
  background: #8b9196;
}

/* 强化前三名的名字显示 */
.top-three .td-agent-name {
  color: #ffffff;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.2);
}

/* 中区域  战术区域*/
.tactical-hub {
  background: #0f1923;
  padding: 14rpx 0;
  /* margin-top: 10rpx; */
}

/* 1. 地图选择器 */
.map-nav {
  padding: 0 12rpx;
  margin-bottom: 16rpx;
}
.map-scroll {
  display: flex;
  height: 80rpx;
}
.map-cell {
  flex: 1;
  /* width: 140rpx; */
  height: 70rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
  background: #1f2326;
  position: relative;
  border: 1rpx solid #383e44;
}
.map-thumb {
  width: 100%;
  height: 100%;
  opacity: 0.5;
  transition: 0.3s;
}
.map-cell.active {
  border-color: #ff4655;
}
.map-cell.active .map-thumb {
  opacity: 1;
}
.map-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #ff4655;
  transform: scaleX(0);
  transition: 0.3s;
}
.map-cell.active .map-line {
  transform: scaleX(1);
}

/* 2. 信息面板 */
.hub-panel {
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  /* margin-bottom: 20rpx; */
}
.panel-tag {
  font-size: 18rpx;
  color: #ff4655;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.map-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #ece8e1;
  text-transform: uppercase;
}
.map-label {
  font-size: 22rpx;
  color: #8b9196;
  margin-left: 10rpx;
}
.panel-action {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #ece8e1;
  padding-bottom: 6rpx;
}
.action-dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff4655;
  margin-left: 10rpx;
  transform: rotate(45deg);
}

/* 3. 卡片展示区 */
.hub-content {
  width: 100%;
}
.card-group {
  display: flex;
  padding: 0 30rpx 20rpx;
}
.point-card {
  flex: 1;
  /* width: 440rpx; */
  background: #1f2326;
  margin-right: 20rpx;
  border: 1rpx solid #383e44;
}
.point-image-box {
  width: 100%;
  height: 240rpx;
  position: relative;
}
.point-img {
  width: 100%;
  height: 100%;
}
.point-hero {
  position: absolute;
  top: 0;
  right: 0;
  background: #ff4655;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  font-weight: bold;
}
.point-details {
  padding: 20rpx;
}
.point-dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff4655;
  margin-right: 12rpx;
}
.point-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.point-name {
  color: #ece8e1;
  font-size: 28rpx;
  font-weight: bold;
}
.point-desc {
  font-size: 20rpx;
  color: #8b9196;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
}

/* 更多卡片 */
.point-more {
  width: 120rpx;
  height: 380rpx; /* 匹配 point-card 总高 */
  background: rgba(255, 70, 85, 0.05);
  border: 1rpx dashed #383e44;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ff4655;
}
.more-plus {
  font-size: 40rpx;
  margin-top: 10rpx;
}

.empty-status {
  font-size: 20rpx;
  color: #383e44;
  letter-spacing: 4rpx;
}

/* 攻防行样式 */
.tactical-row {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(56, 62, 68, 0.5);
}

.side-label {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  writing-mode: vertical-lr; /* 文字竖排 */
  text-align: center;
  letter-spacing: 4rpx;
}

/* 进攻：青色系 */
.side-label.atk {
  background: rgba(0, 184, 161, 0.1);
  color: #00b8a1;
  border-right: 4rpx solid #00b8a1;
}

/* 防守：橙色/红色系 */
.side-label.def {
  background: rgba(255, 70, 85, 0.1);
  color: #ff4655;
  border-right: 4rpx solid #ff4655;
}

.inner-scroll {
  flex: 1;
  height: 100%;
  white-space: nowrap;
}

.mini-card-group {
  display: flex;
  padding: 10rpx 20rpx;
}

.mini-card {
  width: 300rpx;
  height: 180rpx;
  background: #1f2326;
  margin-right: 15rpx;
  flex-shrink: 0;
  position: relative;
  border: 1rpx solid #383e44;
}

.mini-img {
  width: 100%;
  height: 100%;
  opacity: 0.7;
}

.mini-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
}

.mini-name {
  display: block;
  font-size: 22rpx;
  color: #ece8e1;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mini-hero {
  font-size: 16rpx;
  color: #8b9196;
  text-transform: uppercase;
}

.empty-frame {
  border: 1rpx dashed #383e44;
  padding: 40rpx 60rpx;
  text-align: center;
  position: relative;
}

.empty-frame text {
  font-size: 18rpx;
  color: #383e44;
  letter-spacing: 4rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #8b9196;
  margin-top: 20rpx;
  display: block;
  text-align: center;
}

.fixed-height {
  height: 300rpx; /* 假设总高度 */
  background: #0f1923;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 强制切除溢出部分 */
  box-sizing: border-box;
}

.tactical-row {
  height: 50%; /* 完美平分 */
  display: flex;
  align-items: stretch; /* 让 label 和 scroll 撑满高度 */
  position: relative;
  box-sizing: border-box;
}

/* 分割线 */
.row-divider {
  height: 1rpx;
  background: rgba(56, 62, 68, 0.5);
  margin: 0 30rpx;
}

.side-label {
  width: 50rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  writing-mode: vertical-lr;
  letter-spacing: 2rpx;
}

.side-label.atk {
  background: rgba(0, 184, 161, 0.1);
  color: #00b8a1;
  border-right: 2rpx solid #00b8a1;
}

.side-label.def {
  background: rgba(255, 70, 85, 0.1);
  color: #ff4655;
  border-right: 2rpx solid #ff4655;
}

.inner-scroll {
  flex: 1;
  height: 100%; /* 继承父级 50% 的高度 */
  overflow: hidden;
}

.mini-card-group {
  display: flex;
  align-items: center; /* 垂直居中卡片 */
  height: 100%;
  padding: 0 20rpx;
}

.mini-card {
  width: 280rpx;
  height: 160rpx; /* 卡片高度要小于行高(240rpx) */
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #1f2326;
  border: 1rpx solid #383e44;
  position: relative;
}

.mini-img {
  width: 100%;
  height: 100%;
  opacity: 0.6;
}

.mini-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(to top, #000, transparent);
}

.mini-name {
  color: #ece8e1;
  font-size: 22rpx;
  font-weight: bold;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-hero {
  color: #8b9196;
  font-size: 16rpx;
}

/* 占位提示 */
.row-empty-hint {
  color: #383e44;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

/* 空状态对齐 */
.hub-empty {
  position: relative;
  height: 100%;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f1923; /* 容器底色 */
  overflow: hidden;
}

.empty-bg-map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  filter: grayscale(100%) brightness(0.25) contrast(1.2);
  /* 关键点 1：初始透明度设为 0，防止加载瞬间的原图闪烁 */
  opacity: 0;
  transition: opacity 0.4s ease-in-out;
}

/* 关键点 2：当图片加载完成后，由 JS 控制增加这个类 */
.empty-bg-map.loaded {
  opacity: 0.5;
}

.empty-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, transparent 10%, #0f1923 90%);
  z-index: 2;
  pointer-events: none;
}
