<view class="tactical-container">
    <view class="intel-section">
        <swiper class="intel-swiper" autoplay circular interval="4500" indicator-dots indicator-active-color="#FF4655">
            <swiper-item wx:for="{{focusList}}" wx:key="_id">
                <view class="intel-card" bindtap="navToNewsDetail" data-id="{{item._id}}">
                    <image src="{{item.thumb ? item.thumb : '/assets/logos/EDG.png'}}" mode="aspectFill" class="intel-img" />
                    <view class="intel-overlay">
                        <view class="intel-tag-row">
                            <text class="intel-tag">{{item.displayTag || '情报'}}</text>
                            <text class="intel-date">{{item.displayTime}}</text>
                        </view>
                        <text class="intel-title">{{item.title}}</text>
                    </view>
                    <view class="intel-deco-line"></view>
                </view>
            </swiper-item>
        </swiper>
    </view>
    <view class="quick-nav-bar">
        <view class="nav-item" bindtap="navToWiki">
            <text>更新资讯</text>
        </view>
        <view class="nav-item" bindtap="navToAllPoints">
            <text>地图选位</text>
        </view>
        <view class="nav-item" bindtap="navToCrosshair">
            <text>准星库</text>
        </view>
        <view class="nav-item" bindtap="navToProSettings">
            <text>职业外设</text>
        </view>
    </view>
    <!-- 列表区域 table -->
    <view class="list-section">
        <view class="filter-tag-row">
            <view class="filter-tag {{currentRankLabel !== '全部段位' ? 'active' : ''}}" bindtap="openRankPopup">
                <!-- <image class="tag-rank-icon" src="cloud://cloud1-5gqun0xd80e8dd85.636c-cloud1-5gqun0xd80e8dd85-1396911701/valorant_rank_icons/rankList[rankIndex].png" mode="aspectFit" lazy-load /> -->
                <image class="tag-rank-icon" src="cloud://cloud1-5gqun0xd80e8dd85.636c-cloud1-5gqun0xd80e8dd85-1396911701/valorant_rank_icons/{{rankList[rankIndex].icon}}.png" mode="aspectFit" lazy-load />
                <text class="tag-text">{{currentRankLabel || '全段位'}}</text>
                <view class="tag-arrow"></view>
                <view class="tag-deco-line"></view>
            </view>
            <view class="filter-tag {{currentMapLabel !== '全部地图' ? 'active' : ''}}" bindtap="openMapPopup">
                <image class="tag-rank-icon" src="{{currentMapIcon}}" mode="aspectFill" />
                <text class="tag-text">{{maps[currentMapIdx].displayName || '选择地图'}}</text>
                <view class="tag-arrow"></view>
                <view class="tag-deco-line"></view>
            </view>
            <view class="filter-tag {{currentRoleLabel !== '全部角色' ? 'active' : ''}}" bindtap="openRolePopup">
                <image class="tag-rank-icon" src="{{currentRoleIcon}}" mode="aspectFit" />
                <text class="tag-text">{{currentRoleLabel}}</text>
                <view class="tag-arrow"></view>
                <view class="tag-deco-line"></view>
            </view>
            <view class="reset-btn" bindtap="resetFilters">
                <text class="reset-icon">↺</text>
            </view>
        </view>
        <view class="stats-table">
            <block wx:if="{{displayStats.length > 0}}">
                <view class="horizontal-scroll" enable-flex="true">
                    <view class="table-content-wrap">
                        <view class="table-thead">
                            <view class="th rank">#</view>
                            <view class="th agent">特工</view>
                            <view class="th win">胜率</view>
                            <!-- <view class="th nm-win">非镜像胜率</view> -->
                            <view class="th kd">K/D</view>
                            <view class="th pick">登场率</view>
                            <view class="th matches">操作</view>
                        </view>
                        <scroll-view enable-flex="true" scroll-top="{{scrollTop}}" scroll-with-animation="true" scroll-y class="table-tbody">
                            <view class="table-tr {{index < 3 ? 'top-three top-' + (index + 1) : ''}}" wx:for="{{displayStats}}" wx:key="Agent_EN">
                                <view class="td rank">
                                    <text class="rank-num">{{item.rankPos}}</text>
                                </view>
                                <view class="td agent">
                                    <view class="agent-avatar-box">
                                        <image class="td-role-icon" src="{{item.roleIcon}}" mode="aspectFill" />
                                    </view>
                                    <view class="agent-avatar-box">
                                        <image class="td-agent-icon" src="{{item.agentIcon}}" mode="aspectFill" />
                                    </view>
                                    <text class="td-agent-name">{{item.Agent}}</text>
                                </view>
                                <view class="td win {{item.winValue >= 50 ? 'text-green' : 'text-red'}}">
                                    {{item.Win_Rate}}
                                </view>
                                <!-- <view class="td nm-win">{{item.Non_Mirror_WR}}</view> -->
                                <view class="td kd">{{item.KD}}</view>
                                <view class="td pick">{{item.Pick_Rate}}</view>
                                <view class="td matches">
                                    <view class="strategy-btn" catchtap="navToAgentStrategy" data-agent="{{item}}">
                                        <text class="btn-text">详情</text>
                                        <view class="btn-deco"></view>
                                    </view>
                                </view>
                            </view>
                        </scroll-view>
                    </view>
                    <view class="tabbar-bottom-spacer"></view>
                </view>
            </block>
            <view class="empty-container" wx:else>
                <view class="empty-content">
                    <text class="empty-title">暂无战绩数据</text>
                    <text class="empty-desc">该段位下此地图暂无特工表现记录</text>
                </view>
            </view>
        </view>
    </view>
    <role-popup visible="{{isRolePopupShow}}" list="{{roleOptions}}" activeIndex="{{roleIndex}}" bind:close="closeRolePopup" bind:change="onRoleSelect" />
    <map-popup visible="{{isMapPopupShow}}" activeIndex="{{currentMapIdx}}" bind:close="closeMapPopup" bind:change="onMapSelect" />
    <rank-popup visible="{{isPopupShow}}" list="{{rankOptions}}" activeIndex="{{rankIndex}}" bind:close="closeRankPopup" bind:change="onRankSelect" />
</view>