<view class="tactical-container">
    <view class="intel-section">
        <swiper class="intel-swiper" autoplay circular interval="4500" indicator-dots indicator-active-color="#FF4655">
            <swiper-item wx:for="{{newsList}}" wx:key="id">
                <view class="intel-card" bindtap="navToNews" data-info="{{item}}">
                    <image src="{{item.cover}}" mode="aspectFill" class="intel-img" />
                    <view class="intel-overlay">
                        <view class="intel-tag-row">
                            <text class="intel-tag">{{item.tag || '情报'}}</text>
                            <text class="intel-date">{{item.date}}</text>
                        </view>
                        <text class="intel-title">{{item.title}}</text>
                    </view>
                    <view class="intel-deco-line"></view>
                </view>
            </swiper-item>
        </swiper>
    </view>
    <view class="quick-nav-bar">
        <view class="nav-item" bindtap="navToCrosshair">
            <text>准星库</text>
        </view>
        <view class="nav-item" bindtap="navToProSettings">
            <text>职业外设</text>
        </view>
        <view class="nav-item" bindtap="navToSkins">
            <text>皮肤百科</text>
        </view>
        <view class="nav-item" bindtap="navToWiki">
            <text>更新资讯</text>
        </view>
    </view>
    <!-- 战术区域 -->
    <view class="tactical-hub">
        <view class="map-nav">
            <scroll-view class="map-scroll" scroll-x enable-flex scroll-into-view="map-{{currentMapIdx}}">
                <view id="map-{{index}}" class="map-cell {{currentMapIdx === index ? 'active' : ''}}" wx:for="{{maps}}" wx:key="uuid" bindtap="selectMap" data-idx="{{index}}">
                    <image class="map-thumb" src="{{item.listViewIcon}}" mode="aspectFill" />
                    <view class="map-line"></view>
                </view>
            </scroll-view>
        </view>
        <view class="hub-panel">
            <view class="panel-info">
                <view class="panel-title">
                    <text class="map-name">{{maps[currentMapIdx].displayName}}</text>
                    <text class="map-label">点位推荐</text>
                </view>
            </view>
            <view class="panel-action" bindtap="navToAllPoints">
                <text>查看全部</text>
            </view>
        </view>
        <view class="hub-content fixed-height">
            <block wx:if="{{recommendPoints.length > 0}}">
                <view class="tactical-row">
                    <view class="side-label atk">攻方</view>
                    <scroll-view class="inner-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                        <view class="mini-card-group">
                            <view class="mini-card" wx:for="{{atkPoints}}" wx:key="_id" bindtap="navToPointDetail" data-id="{{item._id}}">
                                <image class="mini-img" src="{{item.resultImg}}" mode="aspectFill" />
                                <view class="mini-info">
                                    <text class="mini-name">{{item.title}}</text>
                                    <text class="mini-hero">{{item.heroName}}</text>
                                </view>
                            </view>
                            <view class="row-empty-hint" wx:if="{{atkPoints.length === 0}}">
                                暂无数据
                            </view>
                        </view>
                    </scroll-view>
                </view>
                <view class="row-divider"></view>
                <view class="tactical-row">
                    <view class="side-label def">守方</view>
                    <scroll-view class="inner-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                        <view class="mini-card-group">
                            <view class="mini-card" wx:for="{{defPoints}}" wx:key="_id" bindtap="navToPointDetail" data-id="{{item._id}}">
                                <image class="mini-img" src="{{item.resultImg}}" mode="aspectFill" />
                                <view class="mini-info">
                                    <text class="mini-name">{{item.title}}</text>
                                    <text class="mini-hero">{{item.heroName}}</text>
                                </view>
                            </view>
                            <view class="row-empty-hint" wx:if="{{defPoints.length === 0}}">
                                暂无数据
                            </view>
                        </view>
                    </scroll-view>
                </view>
            </block>
            <view class="hub-empty" wx:else>
                <image class="empty-bg-map {{mapLoaded ? 'loaded' : ''}}" src="{{maps[currentMapIdx].listViewIcon}}" mode="aspectFill" bindload="onMapImgLoad" />
                <view class="empty-overlay"></view>
                <view class="empty-status">
                    <text class="empty-hint">当前地图未检索到部署方案</text>
                </view>
            </view>
        </view>
    </view>
    <!-- 列表区域 table -->
    <view class="list-section">
        <view class="stats-table">
            <block wx:if="{{displayStats.length > 0}}">
                <scroll-view class="horizontal-scroll" scroll-x="true" enable-flex="true">
                    <view class="table-content-wrap">
                        <view class="table-thead">
                            <view class="th rank" bindtap="openRankPopup">
                                <view class="rank-picker-trigger">
                                    <text>{{currentRankLabel}}</text>
                                </view>
                            </view>
                            <view class="th agent">特工</view>
                            <view class="th win">胜率</view>
                            <view class="th nm-win">非镜像胜率</view>
                            <view class="th kd">K/D</view>
                            <view class="th pick">登场率</view>
                            <view class="th matches">对局数</view>
                        </view>
                        <scroll-view enable-flex="true" scroll-top="{{scrollTop}}" scroll-with-animation="true" scroll-y class="table-tbody">
                            <view class="table-tr {{index < 3 ? 'top-three top-' + (index + 1) : ''}}" wx:for="{{displayStats}}" wx:key="Agent_EN" bindtap="navToAgentStrategy" data-agent="{{item}}">
                                <view class="td rank">
                                    <text class="rank-num">{{item.rankPos}}</text>
                                </view>
                                <view class="td agent">
                                    <view class="agent-avatar-box">
                                        <image class="td-role-icon" src="{{item.roleIcon}}" mode="aspectFill" />
                                    </view>
                                    <view class="agent-avatar-box">
                                        <image class="td-agent-icon" src="{{item.agentIcon}}" mode="aspectFill" />
                                    </view>
                                    <text class="td-agent-name">{{item.Agent}}</text>
                                </view>
                                <view class="td win {{item.winValue >= 50 ? 'text-green' : 'text-red'}}">
                                    {{item.Win_Rate}}
                                </view>
                                <view class="td nm-win">{{item.Non_Mirror_WR}}</view>
                                <view class="td kd">{{item.KD}}</view>
                                <view class="td pick">{{item.Pick_Rate}}</view>
                                <view class="td matches">{{item.Matches}}</view>
                            </view>
                        </scroll-view>
                    </view>
                </scroll-view>
            </block>
            <view class="empty-container" wx:else>
                <view class="empty-content">
                    <text class="empty-title">暂无战绩数据</text>
                    <text class="empty-desc">该段位下此地图暂无特工表现记录</text>
                </view>
            </view>
        </view>
    </view>
    <rank-popup visible="{{isPopupShow}}" list="{{rankOptions}}" activeIndex="{{rankIndex}}" bind:close="closeRankPopup" bind:change="onRankSelect" />
</view>