<view class="tactical-container">
    <view class="header-section">
        <view class="tag-row">
            <view class="section-tag">赛季轮换</view>
            <view class="season-badge">
                <text class="season-text">V26</text>
            </view>
        </view>
        <view class="map-grid-fixed">
            <view class="map-item {{currentMapIdx === index ? 'active' : ''}}" wx:for="{{maps}}" wx:key="uuid" bindtap="selectMap" data-idx="{{index}}">
                <image class="map-bg" src="{{item.listViewIcon}}" mode="aspectFill" />
                <view class="active-border" wx:if="{{currentMapIdx === index}}"></view>
                <view class="active-indicator" wx:if="{{currentMapIdx === index}}"></view>
                <view class="map-name">{{item.displayName}}</view>
            </view>
        </view>
    </view>
    <view class="recommend-section">
        <view class="map-section-header">
            <view class="header-left">
                <view class="red-indicator"></view>
                <view class="title-wrap">
                    <text class="map-main-title">战术推荐</text>
                    <view class="title-divider"></view>
                    <text class="map-sub-title">{{maps[currentMapIdx].displayName}}</text>
                </view>
            </view>
            <view class="header-right" bindtap="navToAllPoints">
                <text class="view-all">全部</text>
                <view class="arrow-mini"></view>
            </view>
        </view>
        <block wx:if="{{recommendPoints.length > 0}}">
            <swiper class="spot-swiper animate-fade-in" circular autoplay indicator-dots="true" indicator-active-color="#FF4655" indicator-color="rgba(255, 255, 255, 0.2)">
                <swiper-item wx:for="{{recommendPoints}}" wx:key="_id">
                    <view class="spot-card-modern" bindtap="navToPointDetail" data-id="{{item._id}}">
                        <view class="card-left">
                            <image class="inner-img" src="{{item.resultImg}}" mode="aspectFill" />
                            <view class="img-mask"></view>
                        </view>
                        <view class="card-right">
                            <view class="hero-tag">{{item.heroName}}</view>
                            <view class="spot-name">{{item.title}}</view>
                            <view class="spot-brief">
                                {{item.desc || 'Tactical position record'}}
                            </view>
                        </view>
                        <view class="side-deco"></view>
                    </view>
                </swiper-item>
            </swiper>
        </block>
        <view class="spot-empty-card animate-fade-in" wx:else>
            <view class="empty-card-inner">
                <view class="empty-icon-box">
                    <view class="scan-line"></view>
                    <text class="empty-code">NO DEPLOYMENT</text>
                </view>
                <view class="empty-text-box">
                    <text class="empty-main">暂无战术部署</text>
                    <text class="empty-sub">该地图的英雄推荐点位正在解析中...</text>
                </view>
            </view>
            <view class="corner-deco"></view>
        </view>
    </view>
    <view class="list-section">
        <view class="stats-table">
            <block wx:if="{{displayStats.length > 0}}">
                <scroll-view class="horizontal-scroll" scroll-x="true" enable-flex="true">
                    <view class="table-content-wrap">
                        <view class="table-thead">
                            <view class="th rank" bindtap="openRankPopup">
                                <view class="rank-picker-trigger">
                                    <text>{{currentRankLabel}}</text>
                                </view>
                            </view>
                            <view class="th agent">特工</view>
                            <view class="th win">胜率</view>
                            <view class="th nm-win">非镜像胜率</view>
                            <view class="th kd">K/D</view>
                            <view class="th pick">登场率</view>
                            <view class="th matches">对局数</view>
                        </view>
                        <scroll-view enable-flex="true" scroll-top="{{scrollTop}}" scroll-with-animation="true" scroll-y class="table-tbody">
                            <view class="table-tr {{index < 3 ? 'top-three top-' + (index + 1) : ''}}" wx:for="{{displayStats}}" wx:key="Agent_EN" bindtap="navToAgentStrategy" data-agent="{{item}}">
                                <view class="td rank">
                                    <text class="rank-num">{{item.rankPos}}</text>
                                </view>
                                <view class="td agent">
                                    <view class="agent-avatar-box" style="position: relative;">
                                        <image class="td-role-icon" src="{{item.roleIcon}}" mode="aspectFill" />
                                    </view>
                                    <view class="agent-avatar-box" style="position: relative;">
                                        <image class="td-agent-icon" src="{{item.agentIcon}}" mode="aspectFill" />
                                    </view>
                                    <text class="td-agent-name">{{item.Agent}}</text>
                                </view>
                                <view class="td win {{item.winValue >= 50 ? 'text-green' : 'text-red'}}">
                                    {{item.Win_Rate}}
                                </view>
                                <view class="td nm-win">{{item.Non_Mirror_WR}}</view>
                                <view class="td kd">{{item.KD}}</view>
                                <view class="td pick">{{item.Pick_Rate}}</view>
                                <view class="td matches">{{item.Matches}}</view>
                            </view>
                        </scroll-view>
                    </view>
                </scroll-view>
            </block>
            <view class="empty-container" wx:else>
                <view class="empty-content">
                    <!-- <image class="empty-icon" src="/assets/images/no-data.png" mode="aspectFit" /> -->
                    <text class="empty-title">暂无战绩数据</text>
                    <text class="empty-desc">该段位下此地图暂无特工表现记录</text>
                </view>
            </view>
        </view>
    </view>
    <rank-popup visible="{{isPopupShow}}" list="{{rankOptions}}" activeIndex="{{rankIndex}}" bind:close="closeRankPopup" bind:change="onRankSelect" />
</view>