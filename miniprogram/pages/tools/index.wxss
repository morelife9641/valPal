.page-container {
  min-height: 100vh;
  background-color: #0f1923; /* 经典瓦色 */
  padding: 30rpx;
  color: #ece8e1;
}

/* 用户卡片 */
.user-card {
  position: relative;
  background: #1f2326;
  padding: 40rpx;
  border-left: 10rpx solid #ff4655;
  margin-bottom: 50rpx;
  overflow: hidden;
}

.user-info {
  display: flex;
  align-items: center;
  z-index: 2;
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #ff4655;
  background: #333;
}

.text-info {
  margin-left: 30rpx;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.rank-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 70, 85, 0.2);
  color: #ff4655;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  margin-top: 10rpx;
  font-weight: 900;
}

/* 工具矩阵 */
.section-title {
  font-size: 24rpx;
  color: #8b978f;
  margin-bottom: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 50rpx;
}

.tool-item {
  background: #1f2326;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 1rpx solid #333;
  transition: all 0.2s;
}

.tool-item:active {
  background: #ff4655;
}

.tool-icon {
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

/* 会员横幅 */
.vip-banner {
  background: linear-gradient(90deg, #ff4655, #bd3944);
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 4rpx;
}

.vip-text .title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
}

.vip-text .desc {
  font-size: 20rpx;
  opacity: 0.8;
}

.vip-btn {
  background: #0f1923;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  font-weight: bold;
}
