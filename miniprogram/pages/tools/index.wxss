.container {
  position: relative;
  height: 100vh;
  background-color: #0f1923; /* 确保背景底色一致 */
  overflow: hidden;
}

/* 1. 基础背景容器 */
.grid-bg-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  background-color: #0f1923; /* 瓦罗兰特底色 */
  overflow: hidden;
}

/* 2. 静态底层：精密网格 */
.grid-bg {
  position: absolute;
  width: 200%; /* 扩大范围以支持旋转 */
  height: 200%;
  top: -50%;
  left: -50%;
  transform: rotate(-15deg); /* 稍微倾斜，比 45 度更具动感 */
  opacity: 0.3;

  /* 极细的红黑线 */
  background-image:
    linear-gradient(rgba(255, 70, 85, 0.1) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 70, 85, 0.1) 1rpx, transparent 1rpx);
  background-size: 100rpx 100rpx;
}

/* 3. 动态扫描线：激光扫掠效果 */
.grid-bg::after {
  content: "";
  position: absolute;
  top: 0;
  left: -100%; /* 从屏幕外开始 */
  width: 100%;
  height: 100%;

  /* 🚩 设计点：一条垂直的激光亮带 */
  background: linear-gradient(
    to right,
    transparent 0%,
    rgba(255, 70, 85, 0) 30%,
    rgba(255, 70, 85, 0.4) 50%,
    /* 核心光线 */ rgba(255, 70, 85, 0) 70%,
    transparent 100%
  );

  /* 🚩 动画：激光往复扫掠 */
  /* 使用 ease-in-out 让扫描有节奏感，而不是死板的匀速 */
  animation: laserScan 3s ease-in-out infinite;
  pointer-events: none;
}

/* 4. 辅助点阵：增加“库”的精密感 */
.grid-bg::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* 模拟电子屏幕的点阵感 */
  background-image: radial-gradient(
    rgba(255, 70, 85, 0.2) 1rpx,
    transparent 1rpx
  );
  background-size: 50rpx 50rpx;
}

/* 🚩 扫描动画：只动 transform，流畅度拉满 */
@keyframes laserScan {
  0% {
    transform: translateX(-20%);
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  80% {
    opacity: 1;
  }
  100% {
    transform: translateX(120%);
    opacity: 0;
  }
}

/* 🚩 确保原有内容层级在背景之上 */
.badge-wrapper,
.menu-module {
  position: relative;
  z-index: 1;
}

/* ================= 挂绳与卡片 ================= */
.badge-wrapper {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 物理挂绳 (条纹设计) */
.badge-strap {
  width: 140rpx;
  height: 120rpx;
  /* 改为深灰(#1f2326)与瓦红(#ff4655)的斜纹渐变 */
  background: repeating-linear-gradient(
    45deg,
    #1f2326,
    #1f2326 15rpx,
    #ff4655 15rpx,
    #ff4655 20rpx
  );
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.6);
  position: relative;
  z-index: 104;
  /* 增加一个小细节：中间加个金属扣的视觉效果 */
  border-bottom: 4rpx solid #383e44;
}

.id-card {
  width: 88%;
  /* 换成瓦罗兰特 UI 里的中度灰色，更具金属感 */
  background: #383e44;
  position: relative;
  /* padding: 40rpx 30rpx; */
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.8);
  /* border-radius: 20rpx; */
  margin: -10rpx 0 20rpx;
  margin-top: -20rpx;
  height: 80vh;
}

.stats-module {
  width: 100%;
  /* margin-top: 30rpx; */
  position: relative;
  z-index: 5; /* 确保它盖在背景大字上方 */
}

/* 四角十字 */
.cross-mark {
  position: absolute;
  color: #8b9196;
  font-size: 24rpx;
  font-weight: 900;
}
.tl {
  top: -30rpx;
  left: 10rpx;
  z-index: 200;
}
.tr {
  top: -30rpx;
  right: 10rpx;
  z-index: 200;
}
.bl {
  bottom: 10rpx;
  left: 10rpx;
}
.br {
  bottom: 10rpx;
  right: 10rpx;
}

/* 左右两侧垂直大字 */
.bg-text-vertical {
  position: absolute;
  writing-mode: vertical-rl;
  font-size: 80rpx;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 10rpx;
}
.left-text {
  left: 10rpx;
  top: 50rpx;
  color: #0f1923;
  opacity: 0.1;
  transform: rotate(180deg);
}
.right-text {
  right: 10rpx;
  top: 50rpx;
  color: #ff4655; /* 右侧用亮色呼应图片 */
}

/* 工牌 */

.inner-panel {
  margin-top: -40rpx;
  background: #1f2326;
  position: relative;
  z-index: 5;
  padding: 60rpx; /* 增加内边距给名字留出遮挡空间 */
  border: 1rpx solid rgba(236, 232, 225, 0.3);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  /* border-radius: 20rpx; */
  flex-direction: column;
  align-items: center;
  overflow: hidden; /* 必须加，防止巨大的背景字撑开容器 */
}

/* 1. 头像容器：负责描边和整体形状 */
/* 1. 头像外框（红色描边层） */
/* 1. 头像外框（描边层） */
/* 1. 头像外框（描边层） */
.avatar-box {
  width: 300rpx;
  height: 300rpx;
  background: #ff4655;
  position: relative;
  z-index: 10; /* 🚩 提高层级，压在文字上面 */
  padding: 3rpx;
  /* border: 1px solid red; */
  /* 调整后的深切梯形：短边变长，向内延伸更深 */
  /* clip-path: polygon(93% 0, 93% 20%, 100% 31%, 100% 100%, 0 100%, 0 0); */
}

/* 2. 内层背景 */
.avatar-box::after {
  content: "";
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  right: 3rpx;
  bottom: 3rpx;
  background: #0f1923;
  z-index: -1;
  /* clip-path: polygon(93% 0, 93% 20%, 100% 31%, 100% 100%, 0 100%, 0 0); */
}

/* 3. 图片层 */
.avatar {
  image-rendering: -webkit-optimize-contrast;
  /* 开启 GPU 加速，消除缩放产生的毛刺 */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  filter: contrast(1.05) brightness(1.02);
  /* 配合 clip-path 时，有时加这个可以改善锯齿 */
  -webkit-backface-visibility: hidden;
  width: 100%;
  height: 100%;
  display: block;
  /* clip-path: polygon(93% 0, 93% 20%, 100% 31%, 100% 100%, 0 100%, 0 0); */
}

.user-info-area {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
}

.name-wrap {
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 🚩 昵称主标题 */
.nickname-label {
  color: #ece8e1;
  font-size: 44rpx; /* 大气 */
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase; /* 如果是英文则全大写 */
  line-height: 1.2;
  text-shadow: 0 0 10rpx rgba(236, 232, 225, 0.2);
}

/* ================= 统计数据面板 ================= */
.stats-module {
  width: 100%;
  /* margin-top: 40rpx; */
}
.stats-tab {
  background: #1f2326;
  color: #ece8e1;
  display: inline-block;
  padding: 6rpx 30rpx 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  /* 右侧切角 */
  clip-path: polygon(0 0, calc(100% - 15rpx) 0, 100% 100%, 0 100%);
}
.stats-body {
  /* background: #ece8e1; */
  color: #0f1923;
  display: flex;
  flex-direction: column; /* 🚩 核心：改为垂直排列 */
  padding: 10rpx; /* 给内部留一点缝隙，露出底色边框感 */
  gap: 4rpx; /* 每一行之间的战术间隙 */

  /* 保持你的四角战术切边 */
  clip-path: polygon(
    15rpx 0,
    100% 0,
    100% calc(100% - 15rpx),
    calc(100% - 15rpx) 100%,
    0 100%,
    0 15rpx
  );
}

.menu-row {
  width: 100%; /* 🚩 宽度拉满 */
  background: #1f2326; /* 深色行背景 */
  display: flex; /* 内部内容水平排列 */
  justify-content: space-between; /* 左右两端对齐 */
  align-items: center;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
  /* 移除 margin-bottom，改用父级的 gap 统一控制 */
}

