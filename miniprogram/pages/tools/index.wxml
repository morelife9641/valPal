<view class="container">
    <view class="grid-bg-container">
        <view class="grid-bg"></view>
    </view>
    <view class="badge-wrapper">
        <view class="badge-strap"></view>
        <view class="id-card">
            <view class="cross-mark tl">✖</view>
            <view class="cross-mark tr">✖</view>
            <view class="cross-mark bl">✖</view>
            <view class="cross-mark br">✖</view>
            <view class="inner-panel">
                <view class="avatar-box" bindtap="{{!isLogin ? 'handleLoginClick' : ''}}">
                    <image class="avatar" src="{{isLogin ? userInfo.avatarUrl : '../../assets/news.png'}}" mode="aspectFill"></image>
                </view>
                <view class="name-overlay">
                    <text class="nickname">{{isLogin ? userInfo.nickname : '皮蛋路人甲'}}</text>
                </view>
            </view>
            <view class="stats-module">
                <view class="stats-body">
                    <view class="menu-row" bindtap="openDonate">
                        <view class="point-display">
                            <text class="s-num">{{userInfo.points || 0}}</text>
                            <view class="s-lab">点数</view>
                        </view>
                        <view style="display: flex; align-items: center;">
                            <view class="m-title" style="font-size: 20rpx; opacity: 0.6; margin-right: 10rpx;">
                                获取更多
                            </view>
                            <text class="m-arrow"></text>
                        </view>
                    </view>
                    <view class="menu-row" bindtap="navToFavorites">
                        <text class="m-title">我上传的</text>
                        <!-- <text class="m-arrow">></text> -->
                    </view>
                    <view class="menu-row" bindtap="navToSkinCombo">
                        <text class="m-title">收藏装配</text>
                        <!-- <text class="m-arrow">></text> -->
                    </view>
                    <view class="menu-row" bindtap="navToFavorites">
                        <text class="m-title">收藏战术</text>
                        <!-- <text class="m-arrow">></text> -->
                    </view>
                    <view class="menu-row" bindtap="navToFavorites">
                        <text class="m-title">收藏参数</text>
                        <!-- <text class="m-arrow">></text> -->
                    </view>
                    <view class="menu-row" bindtap="navToFavorites">
                        <text class="m-title">意见反馈</text>
                        <!-- <text class="m-arrow">></text> -->
                    </view>
                    <view class="menu-row" bindtap="navToFavorites">
                        <text class="m-title">联系客服</text>
                        <text class="m-arrow"></text>
                    </view>
                    <!-- <view class="menu-module"> -->
                    <view class="menu-row logout" bindtap="handleLogout" wx:if="{{isLogin}}">
                        <text class="m-title">退出登陆</text>
                        <!-- <text class="m-arrow">></text> -->
                    </view>
                    <!-- </view> -->
                </view>
            </view>
        </view>
    </view>
</view>
<login-popup show="{{showLoginPopup}}" bind:close="onLoginClose" bind:register="onRegister" />