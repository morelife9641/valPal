page {
  background-color: #0f1923; /* 瓦罗兰特深蓝黑 */
  color: #ece8e1;
}

.news-container {
  padding-bottom: 40rpx;
}

/* 焦点新闻 */
.focus-swiper {
  height: 420rpx;
  width: 100%;
}

.category-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between; /* 或者 space-around */
  align-items: center;
  background: #0f1923;
  padding: 0 20rpx;
  height: 90rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.cat-item {
  flex: 1; /* 每个分类等分空间 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
  transition: all 0.3s ease;
}

.cat-text {
  font-size: 26rpx;
  color: rgba(236, 232, 225, 0.5);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.cat-item.active .cat-text {
  color: #ff4655;
  font-weight: bold;
}

/* 底部发光红条 */
.active-line {
  position: absolute;
  bottom: 0;
  width: 40rpx; /* 固定宽度，显得精致 */
  height: 6rpx;
  background: #ff4655;
  box-shadow: 0 0 10rpx #ff4655; /* 荧光效果 */
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.cat-item.active .active-line {
  transform: scaleX(1);
}

/* 新闻列表项 */
.news-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  animation: fadeIn 0.5s ease-out both;
}

.news-info {
  flex: 1;
  padding-right: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

