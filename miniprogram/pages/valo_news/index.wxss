.news-title {
  font-size: 28rpx;
  line-height: 1.4;
  height: 80rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-meta {
  font-size: 22rpx;
  color: rgba(236, 232, 225, 0.4);
  margin-top: 10rpx;
}

.news-thumb {
  width: 220rpx;
  height: 140rpx;
  border-radius: 4rpx;
  background: #1f2326;
}

.load-more {
  text-align: center;
  font-size: 24rpx;
  color: rgba(236, 232, 225, 0.3);
  padding: 40rpx 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 必须给图片加个父容器，方便定位按钮 */
.thumb-container {
  position: relative;
  width: 220rpx;
  height: 140rpx;
}

.item-admin-btn {
  position: absolute;
  top: 0;
  right: 0;
  background: rgba(255, 70, 85, 0.9); /* 瓦罗兰特红 */
  color: white;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  font-weight: bold;
  border-bottom-left-radius: 10rpx;
  z-index: 10;
  letter-spacing: 1rpx;
  box-shadow: -2rpx 2rpx 10rpx rgba(0, 0, 0, 0.5);
}

/* 简单的点击反馈 */
.item-admin-btn:active {
  background: #bd3944;
  transform: scale(0.95);
}
