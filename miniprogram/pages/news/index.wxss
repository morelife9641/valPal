/* 1. 整体容器：使用暗黑色 */
.container {
  background-color: #0f1923; /* VLR/官方常用的暗青黑 */
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* Tabs 导航样式 */
.tab-header {
  display: flex;
  background-color: #17212b;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #2f3942;
}

.tab-item {
  position: relative;
  padding: 30rpx 40rpx;
  color: #8b97a2;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
  flex: 1;
  display: flex;
  justify-content: center;
}

.tab-item.active {
  color: #ece8e1;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #ff4655; /* 官方红下划线 */
  border-radius: 3rpx;
}

/* 占位区样式 */
.placeholder-section {
  text-align: center;
  padding: 200rpx 0;
  color: #4f5962;
  font-size: 26rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx;
  color: #4f5962;
}

/* 确保内容区不会被遮挡 */
.tab-content {
  flex: 1;
}

/* 2. 日期导航栏：深色适配 */
/* 日期导航栏容器 */
.date-nav {
  white-space: nowrap; /* 必须，否则 scroll-view 不横向 */
  background-color: #17212b; /* 略深于背景色，区分层次 */
  padding: 20rpx 0;
  border-bottom: 1rpx solid #2f3942;
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
}

/* 单个日期项 */
.date-item {
  display: inline-flex; /* inline-flex 配合 scroll-view 使用 */
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx; /* 固定宽度保证排列整齐 */
  height: 110rpx;
  margin: 0 10rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease-in-out;
  color: #8b97a2;
}

/* 星期文字 */
.date-item .week {
  font-size: 22rpx;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

/* 日期数字 */
.date-item .day-label {
  font-size: 28rpx;
  font-weight: bold;
  font-family: "DIN", sans-serif; /* 建议用这种窄字体，更有竞技感 */
}

/* --- 激活（选中）状态 --- */
.date-item.active {
  background-color: #ff4655; /* 无畏契约红色背景，或者用 #ece8e1 浅色背景 */
  color: #ffffff;
  box-shadow: 0 4rpx 15rpx rgba(255, 70, 85, 0.3);
  transform: translateY(-2rpx);
}

.date-item.active .week,
.date-item.active .day-label {
  color: #ffffff;
}

/* 如果是“今天”，可以加一个小点标记 */
.date-item.active::after {
  content: "";
  width: 6rpx;
  height: 6rpx;
  background: #fff;
  border-radius: 50%;
  margin-top: 6rpx;
}

/* 3. 赛程卡片：紧凑、扁平、专业 */
.match-card {
  margin: 16rpx 20rpx;
  background: #1a252e;
  border-radius: 8rpx;
  padding: 30rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左侧：时间与赛制 */
.left-time {
  width: 110rpx;
  text-align: left;
}
.left-time .t {
  color: #ece8e1;
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}
.left-time .s {
  color: #7a8288;
  font-size: 20rpx;
  text-transform: uppercase;
}

/* 中间：核心对阵区 */
.middle-vs {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-around; /* 战队-比分-战队均匀分布 */
  padding: 0 10rpx;
}

.v-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}
.v-logo {
  width: 70rpx;
  height: 70rpx;
  margin-bottom: 12rpx;
  /* 即使Logo本身颜色浅，在深色底下也会很清晰 */
}
.v-name {
  color: #ece8e1;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
}

/* 比分与状态 */
.v-score-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}
.v-score {
  color: #ece8e1;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.tag {
  font-size: 18rpx;
  margin-top: 8rpx;
  color: #7a8288;
  background: rgba(255, 255, 255, 0.05);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}
.tag.live {
  color: #ff4655;
  background: rgba(255, 70, 85, 0.1);
  border: 1rpx solid #ff4655;
}

/* 战队 */
.teams-container {
  background: #0f1923;
  padding: 20rpx 0;
}
.team-block {
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #1a252e;
}

.team-header {
  display: flex;
  align-items: center;
  padding: 0 30rpx 20rpx;
}
.team-logo {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}
.team-name {
  color: #ece8e1;
  font-size: 30rpx;
  font-weight: bold;
  display: block;
}
.member-count {
  color: #7a8288;
  font-size: 20rpx;
}

.member-scroll {
  width: 100%;
  height: 220rpx;
}
.member-list {
  display: flex;
  padding-left: 30rpx;
}

.member-card {
  flex-shrink: 0; /* 必须：防止卡片被压扁 */
  width: 160rpx;
  background: #1a252e;
  margin-right: 20rpx;
  padding: 20rpx 10rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 70, 85, 0.1);
  color: #ff4655;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(255, 70, 85, 0.2);
}

.p-name {
  color: #ece8e1;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}
.p-role {
  font-size: 16rpx;
  color: #7a8288;
  text-transform: uppercase;
}
.p-role.is-special {
  color: #ff4655;
  font-weight: bold;
}

/* 赛年 */
/* 赛事 Tab 专属样式 */
.event-timeline {
  padding: 40rpx 20rpx;
  background: #0f1923;
  min-height: 100vh;
}

.event-node {
  display: flex;
  margin-bottom: 0;
}

/* 左侧样式 */
.timeline-left {
  /* width: 100rpx; */
  margin-right: 10px;
  display: flex;
  flex-direction: column; /* 垂直排列 */
  align-items: center; /* 水平居中 */
  justify-content: center; /* 垂直居中 */
  /* 移除之前的 padding-top，由 justify-content 接管位置 */
}

.city-flag {
  font-size: 44rpx;
  margin-bottom: 10rpx; /* 国旗和圆点之间的间距 */
  line-height: 1;
  display: block;
}

.dot-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 让 dot-box 占据剩余高度的一半或固定布局，保证线能连起来 */
  flex: 1;
  width: 100%;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 4rpx solid #1a252e;
  z-index: 10;
  flex-shrink: 0; /* 防止圆点被压缩 */
}

.line {
  width: 2rpx;
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  margin-top: 10rpx; /* 线条从圆点下方出发 */
}

/* 卡片基础 */
.event-card-v2 {
  flex: 1;
  margin-left: 20rpx;
  margin-bottom: 60rpx;
  background: #1a252e;
  padding: 30rpx;
  border-radius: 4rpx;
  position: relative;
  border-left: 8rpx solid #2f3942;
}

/* --- 核心：递增重要程度颜色 --- */

/* 1. 联赛 (青色) */
.league .dot {
  background: #00eeff;
  box-shadow: 0 0 10rpx #00eeff;
}
.league .event-card-v2 {
  border-color: #00eeff;
}

/* 2. 大师赛 (紫色) */
.masters .dot {
  background: #b026ff;
  box-shadow: 0 0 10rpx #b026ff;
}
.masters .event-card-v2 {
  border-color: #b026ff;
  background: linear-gradient(to right, rgba(176, 38, 255, 0.05), #1a252e);
}

/* 3. 冠军赛 (红色 - 最高级) */
.champions .dot {
  background: #ff4655;
  box-shadow: 0 0 20rpx #ff4655;
}
.champions .event-card-v2 {
  border-color: #ff4655;
  background: linear-gradient(to right, rgba(255, 70, 85, 0.1), #1a252e);
}

/* 状态：进行中特有的动效 */
.active .event-card-v2 {
  /* transform: scale(1.02); */
  box-shadow: 0 0 30rpx rgba(255, 70, 85, 0.15);
}

.status-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ece8e1;
  border-radius: 20rpx;
  /* display: flex; */
  margin-left: 10px;
  line-height: 28rpx;
  height: 28rpx;
}

.active .status-badge {
  background: #ff4655;
  margin-left: 10px;
  /* animation: blink 5.5s infinite; */
  display: inline-block;
  height: 28rpx;
  line-height: 28rpx;
}

@keyframes blink {
  50% {
    opacity: 0.7;
  }
}
.card-header {
  display: flex;
  align-items: center;
}

/* 文字细节 */
.event-title {
  color: #ece8e1;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  display: inline-block;
}
.info-row {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
}
.icon {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.info-text {
  color: #8b97a2;
  font-size: 24rpx;
  margin-left: 10rpx;
}
.desc-text {
  color: #7a8288;
  font-size: 22rpx;
  margin-top: 20rpx;
  line-height: 1.4;
}

.global-watermark {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.03);
  font-weight: 900;
  pointer-events: none;
}
