<view class="pro-container">
    <view class="search-section">
        <input class="valo-input" placeholder="搜索选手或战队..." bindinput="onSearch" />
    </view>
    <scroll-view scroll-y class="player-list">
        <view class="player-card" wx:for="{{displayList}}" wx:key="name" bindtap="showDetail" data-player="{{item}}">
            <view class="card-left">
                <image class="player-avatar" src="{{item.avatar}}" mode="aspectFill" lazy-load />
                <view class="player-name">{{item.name}}</view>
                <view class="player-team">{{item.team}} · {{item.role}}</view>
            </view>
            <view class="card-right">
                <view class="edpi-badge">
                    <text class="label">eDPI</text>
                    <text class="value">{{item.technical_settings.eDPI}}</text>
                </view>
                <view class="arrow">〉</view>
            </view>
            <view class="bg-text">{{item.name}}</view>
        </view>
    </scroll-view>
    <view class="detail-modal" wx:if="{{selectedPlayer}}" bindtap="closeDetail">
        <view class="modal-content" catchtap="stopBubble">
            <view class="modal-header">
                <text class="m-name">{{selectedPlayer.name}}</text>
                <text class="m-team">{{selectedPlayer.team}}</text>
            </view>
            <view class="scroll-content">
                <view class="data-grid">
                    <view class="data-item">
                        <text class="d-label">DPI</text>
                        <text class="d-val">{{selectedPlayer.technical_settings.DPI}}</text>
                    </view>
                    <view class="data-item">
                        <text class="d-label">Sens</text>
                        <text class="d-val">{{selectedPlayer.technical_settings.Sensitivity}}</text>
                    </view>
                    <view class="data-item">
                        <text class="d-label">Hz</text>
                        <text class="d-val">{{selectedPlayer.technical_settings.Hz}}</text>
                    </view>
                </view>
                <view class="section-title">EQUIPMENT 外设</view>
                <view class="gear-row" wx:for="{{selectedPlayer.promo_gear}}" wx:key="gear_name">
                    <image class="gear-img" src="/{{item.local_path}}" mode="aspectFit" />
                    <text class="gear-name">{{item.gear_name}}</text>
                </view>
                <view class="section-title">CROSSHAIR 准星代码</view>
                <view class="code-box" bindtap="copyCode" data-code="{{selectedPlayer.technical_settings.Code}}">
                    <text class="code-text">{{selectedPlayer.technical_settings.Code}}</text>
                    <view class="copy-btn">复制</view>
                </view>
            </view>
        </view>
    </view>
</view>