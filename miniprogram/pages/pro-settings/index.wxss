.pro-container {
  background: #0f1923;
  min-height: 100vh;
  padding: 20rpx;
  color: #ece8e1;
}

/* 列表页头像样式 */
.card-left {
  display: flex;
  align-items: center;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #252a2e; /* 占位背景色 */
  border: 2rpx solid #ff4655;
}

/* 详情页头部样式 */
.modal-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #292d30;
}

.m-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  border: 4rpx solid #ff4655;
}

.m-info {
  display: flex;
  flex-direction: column;
}

/* 这里的背景文字 z-index 要调低，防止挡住头像 */
.bg-text {
  z-index: 0;
}
.card-left,
.card-right {
  z-index: 1;
}

/* 搜索框 */
.valo-input {
  background: #1f2326;
  border: 1rpx solid #333;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 30rpx;
}

/* 选手卡片 */
.player-card {
  background: #1f2326;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-left: 6rpx solid #ff4655;
  position: relative;
  overflow: hidden;
}

.player-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #ff4655;
}

.player-team {
  font-size: 22rpx;
  color: #8b978f;
  margin-top: 5rpx;
}

.edpi-badge {
  text-align: right;
  margin-right: 20rpx;
}

.edpi-badge .label {
  font-size: 18rpx;
  display: block;
  color: #8b978f;
}

.edpi-badge .value {
  font-size: 32rpx;
  font-weight: bold;
}

.bg-text {
  position: absolute;
  right: -10rpx;
  bottom: -20rpx;
  font-size: 80rpx;
  font-weight: 900;
  opacity: 0.05;
  font-style: italic;
}

/* 弹窗样式 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  background: #1f2326;
  width: 100%;
  height: 80vh;
  border-top: 8rpx solid #ff4655;
  padding: 40rpx;
  box-sizing: border-box;
}

.m-name {
  font-size: 48rpx;
  font-weight: 900;
  color: #ff4655;
}
.section-title {
  font-size: 22rpx;
  color: #8b978f;
  margin: 40rpx 0 20rpx;
  font-weight: bold;
}

.data-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.data-item {
  flex: 1;
  background: #0f1923;
  padding: 20rpx;
  text-align: center;
  border: 1rpx solid #333;
}
.d-label {
  font-size: 18rpx;
  color: #8b978f;
  display: block;
}
.d-val {
  font-size: 30rpx;
  font-weight: bold;
}

.gear-row {
  display: flex;
  align-items: center;
  background: #0f1923;
  padding: 15rpx;
  margin-bottom: 10rpx;
}
.gear-img {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}
.gear-name {
  font-size: 24rpx;
}

.code-box {
  background: #0f1923;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx dashed #ff4655;
}
.code-text {
  font-size: 20rpx;
  opacity: 0.6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.copy-btn {
  color: #ff4655;
  font-size: 24rpx;
  margin-left: 20rpx;
  font-weight: bold;
}
