.preview-container {
  width: 100vw;
  height: 100vh;
  background: #0f1923;
  position: relative;
}

.full-snapshot {
  width: 100%;
  height: 100%;
  display: block;
}

.bottom-bar {
  position: absolute;
  bottom: 0;
  width: 100%;
  padding: 40rpx 40rpx 80rpx;
  background: linear-gradient(to top, rgba(15, 25, 35, 0.9), transparent);
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info .name {
  color: #ece8e1;
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.info .author {
  color: #ff4655;
  font-size: 24rpx;
}

.btns {
  display: flex;
  gap: 20rpx;
}

/* 基础按钮样式：方块、无圆角 */
.btn-back,
.btn-apply {
  height: 60rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 0; /* 强制方角 */
  transition: opacity 0.1s;
  letter-spacing: 1.3;
}

/* 返回按钮：深色半透明 */
.btns {
  display: flex;
  gap: 24rpx; /* 稍微加大间距，更有呼吸感 */
  padding: 10rpx 0;
}

.btn-back,
.btn-apply {
  height: 64rpx; /* 稍微增加高度，更稳重 */
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx; /* 稍微缩小字号，配合字间距更有设计感 */
  font-weight: 600;
  letter-spacing: 4rpx; /* 加大字间距，显得更硬核、更有质感 */
  text-transform: uppercase; /* 英文或拼音建议全大写 */
  border-radius: 0;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  box-sizing: border-box;
}

/* 返回按钮：虚化背景风格 */
.btn-back {
  background: rgba(255, 255, 255, 0.03);
  color: rgba(236, 232, 225, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(4px); /* 如果背景允许，增加磨砂感 */
}

/* 使用按钮：深浅红色渐变叠加 */
.btn-apply {
  /* 使用微小的径向渐变，让红色中心更有光泽感 */
  background: radial-gradient(circle at center, #ff4655 0%, #d13644 100%);
  color: #ffffff;
  /* 增加顶部的亮色细线，模拟受光面 */
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 20rpx rgba(255, 70, 85, 0.25);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 点击态：不再只是变暗，而是略微下沉并收缩压力 */
.btn-back:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.98);
}

.btn-apply:active {
  background: #bd3944;
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(255, 70, 85, 0.2);
}
