/* 基础背景色：深灰黑 */
page {
  background-color: #060b0f;
}

.valorant-container {
  display: flex;
  padding: 30rpx;
  height: 100vh; /* 撑开高度查看效果 */
  gap: 20rpx;
  box-sizing: border-box;
}

/* --- 左侧面板 --- */
.left-panel {
  flex: 4; /* 占比 40% */
  height: 100%;
}

.card-outline {
  width: 100%;
  height: 100%;
  background: #101820;
  border: 1rpx solid rgba(236, 232, 225, 0.2); /* 淡淡的米白边框 */
  position: relative;
  overflow: hidden;
}

/* 左上角的小装饰 */
.corner-tag {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  font-size: 18rpx;
  color: rgba(236, 232, 225, 0.4);
  letter-spacing: 2rpx;
}

/* --- 右侧面板 --- */
.right-panel {
  flex: 6; /* 剩余部分 */
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-block {
  flex: 1; /* 每个块占 25% 的右侧高度 (即总体的 20% 左右) */
  width: 100%;
}

.block-inner {
  width: 100%;
  height: 100%;
  background: rgba(31, 35, 38, 0.6); /* 半透明深灰 */
  border: 1rpx solid rgba(236, 232, 225, 0.15);
  position: relative;
  box-shadow: inset 0 0 15rpx rgba(0, 0, 0, 0.2);
}

/* 顶部第一个块的特殊淡黄高亮条 */
.nickname-block .header-highlight {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 40rpx;
  background-color: #ece8e1; /* 瓦罗兰特标志性米黄色 */
  opacity: 0.9;
}

/* 通用的装饰小角（图里每个块右下角都有个小灰点） */
.block-inner::after {
  content: "";
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 8rpx;
  height: 8rpx;
  background: rgba(236, 232, 225, 0.2);
}
