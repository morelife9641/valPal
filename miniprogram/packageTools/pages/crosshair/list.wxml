<view class="crosshair-page">
    <view class="grid-bg"></view>
    <view class="archive-header" wx:if="{{isFavoriteOnly && fromUserCenter}}">
        <view class="header-title">
            <text class="title-main">收藏准星库</text>
        </view>
        <view class="back-area" bindtap="navBackToUser">
            <view class="back-text">
                <text class="cn">返回</text>
            </view>
        </view>
        <view class="header-line"></view>
    </view>
    <view class="crosshair-list">
        <view class="ch-card" wx:for="{{crosshairList}}" wx:key="_id">
            <view class="ch-preview">
                <image class="ch-img" src="{{item.img_url}}" mode="aspectFit"></image>
                <view class="favorite-star {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-id="{{item._id}}">
                    {{item.isFavorite ? '★' : '☆'}}
                </view>
            </view>
            <view class="ch-info">
                <view class="ch-name-wrap">
                    <view class="red-bar"></view>
                    <text class="ch-name">{{item.name}}</text>
                </view>
                <view class="copy-btn" catchtap="copyCode" data-code="{{item.code}}" data-name="{{item.name}}">
                    复制准星
                </view>
            </view>
        </view>
    </view>
</view>
<login-popup id="loginPopup" show="{{showLoginPopup}}" bind:close="onLoginClose" bind:register="onRegister" />