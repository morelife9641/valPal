<view class="pro-page">
    <view class="grid-bg"></view>
    <view class="team-group" wx:for="{{groupedList}}" wx:key="teamName">
        <view class="team-header">
            <view class="team-title-wrap">
                <text class="team-prefix">战队</text>
                <text class="team-name">{{item.teamName}}</text>
            </view>
            <view class="team-count">{{item.members.length}}选手</view>
        </view>
        <view class="member-list">
            <view class="pro-card" wx:for="{{item.members}}" wx:for-item="member" wx:key="name" bindtap="navToDetail" data-item="{{member}}">
                <view class="avatar-side">
                    <image class="pro-img" src="{{member.avatar}}" mode="aspectFill" />
                    <view class="role-tag">{{member.role}}</view>
                </view>
                <view class="info-side">
                    <view class="name-row">
                        <text class="pro-name">{{member.name}}</text>
                        <!-- <view class="status-dot"></view> -->
                    </view>
                    <view class="gear-preview">
                        <text wx:for="{{member.promo_gear}}" wx:for-item="gear" wx:key="gear_name">
                            {{gear.gear_name}}
                        </text>
                    </view>
                </view>
                <view class="card-deco">0{{index + 1}}</view>
            </view>
        </view>
    </view>
</view>