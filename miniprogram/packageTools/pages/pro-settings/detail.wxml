<view class="detail-page">
    <view class="pro-header">
        <image class="header-bg" src="{{proInfo.avatar}}" mode="aspectFill" />
        <view class="header-mask"></view>
        <view class="header-content">
            <view class="team-badge">
                <image class="team-logo" src="../../../assets/logos/{{teamLogo}}.png" mode="aspectFit" lazy-load />
                <view class="team-tag">{{proInfo.team}}</view>
            </view>
            <!-- <view class="team-tag">{{proInfo.team}}</view> -->
            <view class="pro-full-name">{{proInfo.name}}</view>
            <view class="info-row"></view>
        </view>
    </view>
    <view class="section-title">选手装备</view>
    <view class="gear-scroll" scroll-x enable-flex>
        <view class="gear-card" wx:for="{{proInfo.promo_gear}}" wx:key="gear_name">
            <image class="gear-img" src="{{item.local_path}}" mode="aspectFit" />
            <text class="gear-name">{{item.gear_name}}</text>
        </view>
    </view>
    <view class="section-title">选手设置</view>
    <view class="settings-grid">
        <view class="setting-item" wx:for="{{mainSettings}}" wx:key="key">
            <text class="setting-label">{{item.key}}</text>
            <text class="setting-value">{{item.value}}</text>
        </view>
    </view>
    <view class="fixed-footer" bindtap="goBack">
        <view class="back-btn-inner">
            <view class="back-arrow">返 回</view>
        </view>
    </view>
</view>