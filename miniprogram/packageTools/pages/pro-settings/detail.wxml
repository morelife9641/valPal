<view class="detail-page">
    <view class="pro-header">
        <image class="header-bg" src="{{proInfo.avatar}}" mode="aspectFill" />
        <view class="header-mask"></view>
        <view class="header-content">
            <text class="team-tag">{{proInfo.team}}</text>
            <text class="pro-full-name">{{proInfo.name}}</text>
            <view class="info-row">
                <text class="role-label">{{proInfo.role}}</text>
                <text class="country-label">// {{proInfo.intro_fields.Country}}</text>
            </view>
        </view>
    </view>
    <view class="section-title">PROMO GEAR //</view>
    <scroll-view class="gear-scroll" scroll-x enable-flex>
        <view class="gear-card" wx:for="{{proInfo.promo_gear}}" wx:key="gear_name">
            <image class="gear-img" src="{{item.local_path}}" mode="aspectFit" />
            <text class="gear-name">{{item.gear_name}}</text>
        </view>
    </scroll-view>
    <view class="section-title">TECHNICAL SETTINGS //</view>
    <view class="settings-grid">
        <view class="setting-item" wx:for="{{mainSettings}}" wx:key="key">
            <text class="setting-label">{{item.key}}</text>
            <text class="setting-value">{{item.value}}</text>
        </view>
    </view>
    <view class="fixed-footer" bindtap="copyCrosshairCode">
        <text>COPY CROSSHAIR CODE</text>
        <view class="copy-icon"></view>
    </view>
</view>