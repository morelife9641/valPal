<view class="skin-container">
    <view class="filter-container">
        <view class="search-section">
            <view class="search-bar">
                <icon type="search" size="16" color="#8e9194"></icon>
                <input type="text" placeholder="搜索皮肤名称..." placeholder-class="search-placeholder" bindinput="onSearchInput" />
            </view>
        </view>
