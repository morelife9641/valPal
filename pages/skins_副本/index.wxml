        <scroll-view class="filter-scroll-view" scroll-x enable-flex>
            <view class="filter-flex-container">
                <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categoryOptions}}">
                    <view class="capsule {{categoryIndex > 0 ? 'active' : ''}}">
                        <text>{{categoryOptions[categoryIndex]}}</text>
                        <view class="mini-arrow"></view>
                    </view>
                </picker>
                <picker bindchange="onRarityChange" value="{{rarityIndex}}" range="{{rarityOptions}}">
                    <view class="capsule {{rarityIndex > 0 ? 'active' : ''}}">
                        <text>{{rarityOptions[rarityIndex]}}</text>
                        <view class="mini-arrow"></view>
                    </view>
                </picker>
                <picker bindchange="onSortChange" value="{{sortIndex}}" range="{{sortOptions}}">
                    <view class="capsule {{sortIndex > 0 ? 'active' : ''}}">
                        <text>{{sortOptions[sortIndex]}}</text>
                        <view class="mini-arrow"></view>
                    </view>
                </picker>
            </view>
        </scroll-view>
    </view>
    <view class="skin-grid">
        <wxs module="rarity">
  var getRarityInfo = function(level) {
    // 将键名改为字符串，并确保语法符合旧版 JS 规范
    var map = {
      '1': { icon: 'Deluxe Edition.png', color: 'rgba(0, 163, 139, 0.2)', theme: '#00A38B' },   
      '2': { icon: 'Select Edition.png', color: 'rgba(90, 154, 210, 0.2)', theme: '#5A9AD2' },   
      '3': { icon: 'Premium Edition.png', color: 'rgba(209, 82, 140, 0.2)', theme: '#D1528C' },  
      '4': { icon: 'Exclusive Edition.png', color: 'rgba(254, 133, 85, 0.2)', theme: '#FE8555' }, 
      '5': { icon: 'Ultra Edition.png', color: 'rgba(239, 211, 48, 0.2)', theme: '#EFD330' }
    };
    // 使用 toString() 确保匹配
    var key = level ? level.toString() : '';
    return map[key] || { icon: '', color: 'rgba(255,255,255,0.05)', theme: '#ccc' };
  }
  module.exports.getInfo = getRarityInfo;
</wxs>
        <view class="skin-card" wx:for="{{skinList}}" wx:key="_id">
            <view class="rarity-line" style="background: {{rarity.getInfo(item.skinRarity).theme}}"></view>
            <view class="img-box" style="background: radial-gradient(circle at center, {{rarity.getInfo(item.skinRarity).color}} 0%, #1a1d23 100%);">
                <image class="rarity-icon" src="/assets/{{rarity.getInfo(item.skinRarity).icon}}" mode="aspectFit"></image>
                <image class="skin-img" src="{{item.picUrl}}" mode="aspectFit" lazy-load="true"></image>
            </view>
            <view class="info-box">
                <text class="skin-name">{{item.name_SC}}</text>
                <view class="bottom-row">
                    <view class="price">
                        <text class="price-val">{{item.priceInChianMainland || '不可售'}}</text>
                    </view>
                    <view class="score" wx:if="{{item.score}}">
                        <text class="score-num">{{item.score}}</text>
                        <text class="score-unit">分</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="load-more" wx:if="{{isFinished}}">—— 到底了 ——</view>
</view>