/* 容器背景 */
page {
  background-color: #0f1114;
  color: #ece8e1;
  padding: 10px 0;
}

/* 顶部筛选栏容器 */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(15, 17, 20, 0.95); /* 半透明深色背景 */
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  padding: 20rpx 0;
}

.type-scroll {
  white-space: nowrap;
  width: 100%;
}

.type-item {
  display: inline-block;
  padding: 12rpx 35rpx;
  margin: 0 15rpx;
  font-size: 26rpx;
  color: #888;
  background: #1c2128;
  border-radius: 4rpx;
  border: 1rpx solid transparent;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 选中状态：红色边框与文字 */
.type-item.active {
  color: #fff;
  background: #252930;
  border-color: #ff4655;
  font-weight: bold;
  box-shadow: 0 4rpx 15rpx rgba(255, 70, 85, 0.2);
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.weapon-card {
  background: #1c2128;
  margin: 20rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.weapon-card.active {
  border-color: #ff4655; /* 展开时高亮边框 */
  background: #232931;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
}

/* 头部样式 */
.card-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.gun-icon {
  width: 200rpx;
  height: 80rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 5rpx 10rpx rgba(0, 0, 0, 0.3));
}

.header-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.cn-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}
.en-name {
  font-size: 18rpx;
  color: #666;
  text-transform: uppercase;
  margin-top: 4rpx;
}

.header-right {
  text-align: right;
}
.price-tag {
  display: block;
  color: #00ffcc;
  font-size: 26rpx;
  font-weight: bold;
}
.price-tag.free {
  color: #ff4655;
}
.type-text {
  font-size: 18rpx;
  color: #888;
  background: #2a2f36;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

/* 详情面板 */
.card-detail {
  padding: 0 30rpx 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 进度条网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  padding: 30rpx 0;
}

/* index.wxss */

.stat-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end; /* 底部对齐，让数值和单位看起来更整齐 */
  margin-bottom: 10rpx;
  font-size: 20rpx;
  color: #888;
  white-space: nowrap; /* 【关键】强制文字不换行 */
}

.stat-info text:first-child {
  flex-shrink: 0; /* 标题（如“填弹速度”）不收缩 */
  margin-right: 10rpx;
}

.stat-info text:last-child {
  color: #eee;
  font-weight: bold;
  flex-shrink: 0; /* 【关键】数值区域不收缩，确保撑开空间 */
  text-align: right;
}

.stat-info small {
  font-size: 14rpx;
  color: #555;
  margin-left: 4rpx;
  font-weight: normal; /* 单位变细，突出数值 */
}

.bar-bg {
  height: 6rpx;
  background: #0a0c0e;
  border-radius: 3rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #00ffcc;
  border-radius: 3rpx;
  transition: width 0.8s ease-out;
}

/* 辅助属性 */
.misc-info {
  display: flex;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.2);
  padding: 15rpx 20rpx;
  border-radius: 4rpx;
}
.misc-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.misc-item .label {
  font-size: 16rpx;
  color: #666;
  margin-bottom: 6rpx;
}
.misc-item .val {
  font-size: 20rpx;
  color: #ccc;
}

/* 伤害表 */
.damage-section {
  margin-top: 30rpx;
  background: #111;
  border-radius: 4rpx;
  overflow: hidden;
}
.table-header,
.table-row {
  display: flex;
  padding: 16rpx 10rpx;
  border-bottom: 1rpx solid #222;
}
.td {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
}
.td-range {
  width: 140rpx;
  font-size: 20rpx;
  color: #888;
  text-align: center;
}
.table-header {
  background: #1a1d23;
  color: #666;
}
.head {
  color: #ff4655;
  font-weight: bold;
}

.weapon-desc {
  font-size: 18rpx;
  color: #555;
  margin-top: 24rpx;
  line-height: 1.6;
  padding: 15rpx;
  border-left: 4rpx solid #333;
}

.group-header {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 10rpx;
}

.group-title {
  color: #ff4655;
  font-size: 24rpx;
  font-weight: 800;
  text-transform: uppercase;
  margin-right: 20rpx;
}

.group-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(to right, rgba(255, 70, 85, 0.4), transparent);
}
