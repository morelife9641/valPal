page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

/* 画布占满全屏 */
.canvas-full-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
}

#wallpaperCanvas {
  width: 100%;
  height: 100%;
}

/* 悬浮按钮组 */
.floating-controls {
  position: fixed;
  right: 30rpx;
  top: 15%;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.icon-btn {
  width: 100rpx;
  height: 100rpx;
  background: rgba(23, 33, 43, 0.8);
  border: 2rpx solid #ff4655;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.icon-btn image {
  width: 50rpx;
  height: 50rpx;
}
.icon-btn text {
  font-size: 20rpx;
  color: #fff;
  margin-top: 5rpx;
}

/* 底部弹窗 */
.bottom-popup {
  position: fixed;
  bottom: -500rpx; /* 默认隐藏 */
  left: 0;
  width: 100%;
  height: 450rpx;
  background: rgba(23, 33, 43, 0.95);
  border-top: 4rpx solid #ff4655;
  transition: bottom 0.3s ease;
  z-index: 100;
  padding: 20rpx;
  box-sizing: border-box;
}

.bottom-popup.show {
  bottom: 0;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  color: #fff;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
